<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HappenHub</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <!-- FullCalendar CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/fullcalendar/6.1.15/index.global.min.css" rel="stylesheet" />
    
    <!-- Flatpickr CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">

    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/cropperjs@1.5.13/dist/cropper.min.css", media: "all" %>
    
    <!-- Flatpickr JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
    <!-- FullCalendar JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fullcalendar/6.1.15/index.global.min.js"></script>
    <%= javascript_include_tag "https://maps.googleapis.com/maps/api/js?key=#{Rails.application.credentials.dig(:google, :maps, :api_key)}&libraries=places", async: true, defer: true %>

    <%= javascript_importmap_tags %>
  </head>
  <body class="flex flex-col min-h-screen bg-primary text-accent-black font-sans">
    <!-- Header -->
    <header class="bg-accent-red text-white py-4 shadow-md">
      <div class="container mx-auto px-4 flex justify-between items-center">
        <!-- Logo -->
        <h1 class="text-2xl font-bold">
          <%= link_to "HappenHub", dashboard_path %>
        </h1>

        <!-- Navigation -->
        <%= render "layouts/navigation" %>
      </div>
    </header>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8 flex-grow">
      <!-- Flash Messages -->
      <div id="flash-messages" class="fixed bottom-6 left-4 space-y-2 z-50">
        <% flash.each do |type, message| %>
          <div class="flash-message <%= flash_class(type) %> p-4 rounded-lg shadow-md">
            <%= message %>
            <button class="close-flash ml-4 text-sm font-bold text-white hover:opacity-75" onclick="this.parentElement.style.display='none';">×</button>
          </div>
        <% end %>
      </div>

      <%= yield %>
    </main>

    <!-- Footer (Fixed at Bottom) -->
    <footer class="bg-gray-800 text-white text-center py-4 mt-auto">
      <p>© <%= Date.today.year %> HappenHub. All rights reserved.</p>
    </footer>
  </body>
</html>
