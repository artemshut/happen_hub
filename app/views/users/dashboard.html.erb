<div class="container mx-auto px-6 py-10 animate-fade-in">
  <!-- Header -->
  <h1 class="text-4xl font-extrabold text-gray-900 mb-10">
    Hey <%= current_user.first_name %>, here’s what’s happening 🎉
  </h1>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">
    <!-- Event Feed -->
    <div class="lg:col-span-2 space-y-8">
      <% if @upcoming_events.any? %>
        <% grouped = @upcoming_events.includes(:event_category).group_by(&:event_category) %>
        <% grouped.each do |category, events| %>
          <div>
            <h2 class="text-lg font-semibold text-gray-600 uppercase tracking-wide mb-4 flex items-center gap-2">
              <%= category.emoji %> <%= category.name %>
            </h2>
            <div class="space-y-6">
              <% events.each do |event| %>
                <div class="bg-white rounded-3xl shadow-sm hover:shadow-xl transition overflow-visible">
                  <!-- Event image placeholder -->
                  <div class="relative h-48 bg-gradient-to-r from-gray-200 to-gray-300 flex items-center justify-center">
                    <span class="absolute top-4 left-4 bg-accent-red text-white px-4 py-2 rounded-xl font-bold text-sm shadow">
                      <%= event.start_time.strftime("%b %d") %>
                    </span>
                    <span class="text-gray-500 text-sm">No cover image</span>
                  </div>

                  <div class="p-6">
                    <h3 class="text-2xl font-bold text-gray-900 hover:text-accent-red transition">
                      <%= link_to event.title, event_path(event) %>
                    </h3>
                    <p class="text-sm text-gray-500 mt-1"><%= formatted_event_date(event.start_time) %></p>

                    <!-- Participants -->
                    <div class="flex items-center gap-2 mt-4">
                      <% event.event_participations.limit(5).each do |p| %>
                        <div class="relative group">
                          <% if p.user.avatar.attached? %>
                            <%= image_tag p.user.avatar.variant(resize_to_fill: [40, 40]),
                                  class: "w-10 h-10 rounded-full object-cover ring-2 ring-white shadow cursor-pointer" %>
                          <% else %>
                            <div class="bg-accent-red text-white w-10 h-10 flex items-center justify-center rounded-full text-lg font-bold ring-2 ring-white shadow cursor-pointer">
                              <%= p.user.first_name[0].upcase %>
                            </div>
                          <% end %>

                          <!-- Hover Card -->
                          <div class="absolute left-1/2 -translate-x-1/2 top-12 w-64 bg-white rounded-xl shadow-lg border border-gray-200 p-4 z-50 
                                      hidden group-hover:block">
                            <div class="flex items-center gap-3">
                              <% if p.user.avatar.attached? %>
                                <%= image_tag p.user.avatar.variant(resize_to_fill: [50, 50]),
                                      class: "w-12 h-12 rounded-full object-cover ring-2 ring-gray-100" %>
                              <% else %>
                                <div class="bg-accent-red text-white w-12 h-12 flex items-center justify-center rounded-full text-xl font-bold ring-2 ring-gray-100">
                                  <%= p.user.first_name[0].upcase %>
                                </div>
                              <% end %>
                              <div>
                                <p class="text-gray-900 font-semibold"><%= p.user.full_name %></p>
                                <p class="text-sm text-gray-500"><%= p.user.username %></p>
                              </div>
                            </div>
                            <div class="mt-3 text-sm text-gray-600">
                              <p><span class="font-medium">Joined:</span> <%= p.user.created_at.strftime("%B %Y") %></p>
                              <p><span class="font-medium">Events:</span> <%= p.user.event_participations.count %></p>
                            </div>
                            <div class="mt-4">
                              <%= link_to "View Profile", profile_path(p.user),
                                    class: "text-accent-red text-sm font-semibold hover:underline" %>
                            </div>
                          </div>
                        </div>
                      <% end %>

                      <% if event.event_participations.count > 5 %>
                        <span class="text-xs text-gray-500 font-medium">+<%= event.event_participations.count - 5 %> more</span>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-gray-600">
          No upcoming events.
          <%= link_to "Create one", new_event_path, class: "text-accent-red font-medium hover:underline" %>.
        </p>
      <% end %>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-2 space-y-8">
      <!-- Calendar -->
      <div class="bg-white rounded-3xl shadow-sm p-6">
        <%= render 'shared/calendar' %>
      </div>

      <!-- Quick Actions -->
      <div class="bg-white rounded-3xl shadow-sm p-6">
        <%= render 'quick_actions' %>
      </div>

      <!-- Stats -->
      <div class="bg-white rounded-3xl shadow-sm p-6">
        <%= render 'stats',
            total_events: @total_events,
            total_groups: @total_groups,
            total_friends: @total_friends %>
      </div>
    </div>
  </div>
</div>
