<div class="container mx-auto px-4 py-6 animate-fade-in">
  <!-- Welcome Header -->
  <h1 class="text-3xl font-bold text-gray-800 mb-8">Welcome to Your Dashboard</h1>

  <div class="flex flex-wrap lg:flex-nowrap gap-6">
    <!-- Main Content -->
    <div class="w-full lg:w-7/12 space-y-8">
      <!-- Upcoming Events -->
      <div class="bg-white shadow-md rounded-xl p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-4">Upcoming Events</h2>
        <% if @upcoming_events.any? %>
          <% grouped = @upcoming_events.includes(:event_category).group_by(&:event_category) %>
          <% grouped.each do |category, events| %>
            <div class="mb-6">
              <h3 class="text-lg font-bold text-gray-700 mb-3"><%= category.emoji %> <%= category.name %></h3>
              <ul class="space-y-3">
                <% events.each do |event| %>
                  <li class="bg-white rounded-lg shadow p-4 hover:shadow-md transition">
                    <h4 class="text-accent-red font-semibold text-lg"><%= link_to event.title, event_path(event) %></h4>
                    <p class="text-sm text-gray-500"><%= formatted_event_date(event.start_time) %></p>
                    <%= render partial: "events/invitation_status_small", locals: { event: event } %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        <% else %>
          <p class="text-gray-600">No upcoming events. <%= link_to "Create one", new_event_path, class: "text-accent-red hover:underline" %>.</p>
        <% end %>
      </div>

      <div class="bg-white shadow-md rounded-xl p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-4">Past Events</h2>
        <% if @past_events.any? %>
          <% grouped = @past_events.includes(:event_category).group_by(&:event_category) %>
          <% grouped.each do |category, events| %>
            <div class="mb-6">
              <h3 class="text-lg font-bold text-gray-700 mb-3"><%= category.emoji %> <%= category.name %></h3>
              <ul class="space-y-3">
                <% events.each do |event| %>
                  <li class="bg-white rounded-lg shadow p-4 hover:shadow-md transition">
                    <h4 class="text-accent-red font-semibold text-lg"><%= link_to event.title, event_path(event) %></h4>
                    <p class="text-sm text-gray-500"><%= formatted_event_date(event.start_time) %></p>
                    <%= render partial: "events/invitation_status_small", locals: { event: event } %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        <% else %>
          <p class="text-gray-600">No past events.</p>
        <% end %>
      </div>

      <!-- Pending Invitations -->
      <div class="bg-white shadow-md rounded-xl p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-4">Pending Invitations</h2>
        <% if @pending_invitations.any? %>
          <ul class="space-y-4">
            <% @pending_invitations.each do |invite| %>
              <li class="border border-gray-200 rounded-lg p-4">
                <p class="text-gray-700 font-medium">
                  <%= invite.event.title %>
                </p>
                <p class="text-sm text-gray-500">
                  <%= invite.event.start_time.strftime('%B %d, %Y') %>
                </p>
                <div class="flex flex-wrap gap-2 mt-3">
                  <%= link_to "✔ Accept", update_rsvp_event_path(invite.event, status: "accepted"),
                      method: :patch,
                      class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-semibold shadow-sm transition" %>
                  <%= link_to "🤔 Maybe", update_rsvp_event_path(invite.event, status: "maybe"),
                      method: :patch,
                      class: "bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-2 rounded-lg text-sm font-semibold shadow-sm transition" %>
                  <%= link_to "✖ Decline", update_rsvp_event_path(invite.event, status: "declined"),
                      method: :delete,
                      class: "bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-lg text-sm font-semibold shadow-sm transition" %>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-gray-600">No pending event invitations.</p>
        <% end %>
      </div>

      <!-- Friend Activity -->
      <div class="bg-white shadow-md rounded-xl p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-4">Friend Activity</h2>
        <% if @friend_activities.any? %>
          <ul class="space-y-3">
            <% @friend_activities.each do |activity| %>
              <li class="text-sm text-gray-700">
                <span class="font-medium"><%= activity.user.full_name + " #{Activity::ACTIVITIES[activity.action.to_sym]}" %></span>
                <span class="text-gray-500">· <%= time_ago_in_words(activity.created_at) %> ago</span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-gray-600">No recent friend activity.</p>
        <% end %>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="w-full lg:w-5/12 space-y-8">
      <!-- Calendar -->
      <%= render 'shared/calendar' %>

      <!-- Quick Actions -->
      <%= render 'quick_actions' %>

      <!-- Stats -->
      <%= render 'stats', total_events: @total_events, total_groups: @total_groups, total_friends: @total_friends %>
    </div>
  </div>
</div>
