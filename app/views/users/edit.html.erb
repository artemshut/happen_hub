<div class="max-w-3xl mx-auto px-6 py-10 bg-white rounded-xl shadow-md animate-fade-in">
  <h1 class="text-3xl font-bold text-gray-900 mb-8">Edit Profile</h1>

  <%= form_for @user, url: update_profile_path, class: "space-y-6" do |f| %>
    <!-- First Name -->
    <div>
      <%= f.label :first_name, "First Name", class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.text_field :first_name, required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-accent-red" %>
    </div>

    <!-- Last Name -->
    <div>
      <%= f.label :last_name, "Last Name", class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.text_field :last_name, required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-accent-red" %>
    </div>

    <!-- Email -->
    <div>
      <%= f.label :email, "Email", class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.email_field :email, required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-accent-red" %>
    </div>

    <!-- Birthday -->
    <div>
      <%= f.label :birthday, "Birthday", class: "block text-gray-700 font-semibold mb-2" %>
      <div class="flex gap-2">
        <%= f.date_select :birthday,
              start_year: 1900,
              end_year: Date.today.year - 18,
              class: "w-full border border-gray-300 rounded-lg px-2 py-1 focus:ring-2 focus:ring-accent-red" %>
      </div>
    </div>

    <!-- Password -->
    <div>
      <%= f.label :password, "New Password", class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.password_field :password, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-accent-red" %>
    </div>

    <!-- Password Confirmation -->
    <div>
      <%= f.label :password_confirmation, "Confirm Password", class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.password_field :password_confirmation, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-accent-red" %>
    </div>

    <!-- Submit -->
    <div class="pt-4 text-right">
      <%= f.submit 'Update Profile',
            class: "bg-accent-red text-white px-6 py-3 rounded-lg font-semibold hover:bg-red-600 transition shadow-sm" %>
    </div>
  <% end %>
</div>
