<% if users.any? %>
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 animate-fade-in">
    <% users.each do |user| %>
      <div class="flex justify-between items-center bg-gray-50 p-4 rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-all">
        <div>
          <p class="font-semibold text-gray-800"><%= user.full_name %></p>
          <p class="mt-1">
            <span class="inline-block bg-gray-200 text-gray-700 text-xs font-medium px-2 py-0.5 rounded-full">
              @<%= user.tag %>
            </span>
          </p>
        </div>
        <%= button_to "Add Friend",
              friendships_path(friend_id: user.id),
              method: :post,
              class: "bg-accent-pink text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-pink-600 transition" %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-gray-500 text-sm animate-fade-in">No users found for that tag.</p>
<% end %>
