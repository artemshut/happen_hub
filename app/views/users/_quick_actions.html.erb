<div class="glass-panel space-y-6" data-controller="availability">
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-bold text-neutral-text">Quick Actions</h2>
    <span class="soft-badge">
      <i class="fa-solid fa-bolt"></i>
      Instant flows
    </span>
  </div>

  <div class="grid gap-3">
    <%= link_to new_event_path,
          class: "chip-link--primary justify-center text-base" do %>
      <i class="fa-solid fa-calendar-plus"></i>
      Create a new event
    <% end %>

    <%= link_to new_group_path,
          class: "chip-link justify-center text-base" do %>
      <i class="fa-solid fa-people-line"></i>
      Spin up a group
    <% end %>

    <button
      type="button"
      data-action="click->availability#open"
      class="chip-link justify-center text-base"
    >
      <i class="fa-solid fa-clock-rotate-left"></i>
      Check collective availability
    </button>
  </div>

  <p class="text-xs text-neutral-muted/80">
    Use these shortcuts to keep momentum high—your community feels every beat you set.
  </p>
</div>
