<div class="glass-panel space-y-5">
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-semibold text-neutral-text">Recent highlights</h2>
    <span class="soft-badge">
      <i class="fa-solid fa-sparkles"></i>
      Memories
    </span>
  </div>

  <% if past_events.any? %>
    <div class="space-y-4">
      <% past_events.limit(4).each do |event| %>
        <div class="timeline-card group flex items-center justify-between gap-4 border border-transparent transition hover:border-brand-light/40 hover:bg-brand-soft/40">
          <div>
            <p class="text-sm font-semibold text-neutral-text group-hover:text-brand">
              <%= link_to event.title, event_path(event) %>
            </p>
            <p class="text-xs text-neutral-muted">
              <%= event.start_time.strftime("%b %d, %Y") %>
            </p>
          </div>
          <%= link_to event_path(event), class: "chip-link text-xs" do %>
            <i class="fa-solid fa-reply"></i>
            Revisit
          <% end %>
        </div>
      <% end %>
    </div>

    <% if past_events.count > 4 %>
      <div class="pt-2 text-right">
        <%= link_to events_path(past: true), class: "chip-link text-xs" do %>
          View all past events
          <i class="fa-solid fa-arrow-up-right-from-square"></i>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="text-sm text-neutral-muted">
      You haven’t hosted anything yet—your first recap will shine here.
    </div>
  <% end %>
</div>
