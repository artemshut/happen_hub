<div class="bg-white rounded-3xl shadow-sm p-6">
  <h2 class="text-xl font-semibold text-gray-900 mb-4">Past Events</h2>

  <% if past_events.any? %>
    <ul class="space-y-3">
      <% past_events.limit(3).each do |event| %>
        <li class="flex items-start justify-between group">
          <div>
            <h3 class="text-sm font-medium text-gray-700 group-hover:text-accent-pink transition">
              <%= link_to event.title, event_path(event) %>
            </h3>
            <p class="text-xs text-gray-500">
              <%= event.start_time.strftime("%b %d, %Y") %>
            </p>
          </div>
          <!-- little faded badge -->
          <span class="text-xs px-2 py-1 rounded-lg bg-gray-100 text-gray-500 font-semibold">
            Past
          </span>
        </li>
      <% end %>
    </ul>

    <% if past_events.count > 3 %>
      <div class="mt-4">
        <%= link_to "View all past events →", events_path(past: true),
            class: "text-sm text-accent-red font-medium hover:underline" %>
      </div>
    <% end %>
  <% else %>
    <p class="text-gray-500 text-sm">No past events yet.</p>
  <% end %>
</div>
