<div class="glass-panel space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-bold text-neutral-text">Your Impact</h2>
      <p class="text-sm text-neutral-muted">A quick pulse on your community footprint.</p>
    </div>
    <span class="soft-badge">
      <i class="fa-solid fa-chart-line"></i>
      Live stats
    </span>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="metric-card">
      <span class="metric-value"><%= total_events || 0 %></span>
      <span class="metric-label">Events Hosted</span>
      <p class="mt-3 text-xs text-neutral-muted">
        Curated moments you brought to life.
      </p>
    </div>
    <div class="metric-card">
      <span class="metric-value"><%= total_groups || 0 %></span>
      <span class="metric-label">Groups Connected</span>
      <p class="mt-3 text-xs text-neutral-muted">
        Communities you actively engage with.
      </p>
    </div>
    <div class="metric-card">
      <span class="metric-value"><%= total_friends || 0 %></span>
      <span class="metric-label">Friends Orbit</span>
      <p class="mt-3 text-xs text-neutral-muted">
        Your growing network of collaborators.
      </p>
    </div>
  </div>
</div>
