<h2 class="text-xl font-bold mb-4">Your Stats</h2>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 animate-fade-in">
  <!-- Events -->
  <div class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-all text-center">
    <p class="text-3xl font-bold text-accent-red"><%= @total_events || 0 %></p>
    <p class="text-gray-600 mt-1">Events Attended</p>
  </div>

  <!-- Groups -->
  <div class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-all text-center">
    <p class="text-3xl font-bold text-accent-red"><%= @total_groups || 0 %></p>
    <p class="text-gray-600 mt-1">Groups Joined</p>
  </div>

  <!-- Friends -->
  <div class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md transition-all text-center">
    <p class="text-3xl font-bold text-accent-red"><%= @total_friends || 0 %></p>
    <p class="text-gray-600 mt-1">Total Friends</p>
  </div>
</div>
