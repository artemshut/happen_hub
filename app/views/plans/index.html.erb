<div class="landing-section py-16">
  <div class="landing-bubble w-96 h-96 -left-20 top-24 opacity-30 animate-floatSlow"></div>
  <div class="landing-bubble w-[28rem] h-[28rem] right-12 top-0 opacity-20 animate-floatSlow" style="animation-delay: 1.4s;"></div>

  <div class="space-y-12 relative z-10">
    <div class="text-center space-y-4 max-w-3xl mx-auto">
      <span class="landing-pill justify-center text-sm font-semibold gap-3">
        <i class="fa-solid fa-sparkles text-brand"></i>
        Plans for every host
      </span>
      <h1 class="text-4xl font-extrabold text-neutral-text sm:text-5xl">
        Choose the vibe that matches your hosting energy
      </h1>
      <p class="text-lg text-neutral-muted">
        From spontaneous hangs to multi-day adventures, unlock RSVP boosts, invite insights, and more room for creativity.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      <% @plans.each do |plan| %>
        <% is_current = current_user&.plan_id == plan.id %>
        <div class="rounded-3xl border <%= plan.highlighted? ? 'border-brand shadow-glow bg-white/90' : 'border-neutral-200 bg-white' %> p-6 flex flex-col gap-6">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <p class="text-sm font-semibold uppercase tracking-[0.3em] text-neutral-muted"><%= plan.key.titleize %></p>
              <% if plan.highlighted? %>
                <span class="soft-badge text-brand">
                  <i class="fa-solid fa-fire"></i>
                  Popular
                </span>
              <% end %>
            </div>
            <h2 class="text-2xl font-bold text-neutral-text"><%= plan.name %></h2>
            <p class="text-neutral-muted text-sm"><%= plan.tagline %></p>
          </div>

          <div>
            <p class="text-4xl font-extrabold text-neutral-text"><%= plan_price_label(plan) %></p>
            <p class="text-sm text-neutral-muted mt-1"><%= plan_limit_label(plan) %></p>
          </div>

          <ul class="space-y-3 text-sm text-neutral-text">
            <% plan.feature_list.each do |feature| %>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-circle-check text-brand mt-1"></i>
                <span><%= feature %></span>
              </li>
            <% end %>
          </ul>

          <div class="mt-auto">
            <% if user_signed_in? %>
              <% if is_current %>
                <div class="chip-link w-full justify-center bg-neutral-100 text-neutral-muted cursor-not-allowed">
                  Current plan
                </div>
              <% else %>
                <%= button_to activate_plan_path(plan), method: :post, class: "chip-link--primary w-full justify-center", data: { turbo: true } do %>
                  <%= current_user.plan&.priority.to_i < plan.priority ? "Upgrade" : "Switch" %> to <%= plan.name %>
                <% end %>
              <% end %>
            <% else %>
              <%= link_to new_user_registration_path, class: "chip-link--primary w-full justify-center" do %>
                Start with <%= plan.name %>
              <% end %>
            <% end %>
          </div>

          <% if is_current && !plan.unlimited_events? %>
            <p class="text-xs text-neutral-muted text-center">
              <%= pluralize(current_user.events_remaining_on_plan, "active event") %> left on this plan
            </p>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      <div class="glass-panel">
        <h3 class="text-lg font-semibold text-neutral-text mb-2">Insights included</h3>
        <p class="text-sm text-neutral-muted">
          Every plan includes RSVP sync, Smart Suggestions, and share tracking so you never lose context.
        </p>
      </div>
      <div class="glass-panel">
        <h3 class="text-lg font-semibold text-neutral-text mb-2">Upgrade anytime</h3>
        <p class="text-sm text-neutral-muted">
          Hosting a bigger retreat soon? Switch plans instantly—your data, invites, and guests stay intact.
        </p>
      </div>
      <div class="glass-panel">
        <h3 class="text-lg font-semibold text-neutral-text mb-2">Need something custom?</h3>
        <p class="text-sm text-neutral-muted">
          Reach out at <%= mail_to "hello@happenhub.co" %> for concierge support, branded experiences, and group onboarding.
        </p>
      </div>
    </div>
  </div>
</div>
