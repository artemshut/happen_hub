<% content_for :main_classes, "relative flex-grow overflow-x-hidden pb-20" %>

<div class="full-bleed overflow-hidden bg-gradient-to-br from-brand-soft/40 via-neutral-bg to-neutral-bg pb-24">
  <div class="landing-bubble w-[26rem] h-[26rem] -left-24 top-12 opacity-40 animate-floatSlow"></div>
  <div class="landing-bubble w-[22rem] h-[22rem] right-[-6rem] top-20 opacity-30 animate-floatSlow" style="animation-delay: 1.2s;"></div>
  <div class="landing-bubble w-[32rem] h-[32rem] left-1/3 top-[32rem] opacity-20 animate-pulseRing"></div>

  <section class="landing-section">
    <div class="space-y-12">
      <header class="glass-panel bg-gradient-to-r from-brand-gradientFrom/95 via-brand-gradientVia/85 to-brand-gradientTo/90 text-white shadow-[0_35px_80px_rgba(124,58,237,0.35)]">
        <div class="flex flex-wrap items-start justify-between gap-6">
          <div>
            <p class="text-xs uppercase tracking-[0.45em] text-white/70">Happen together</p>
            <h1 class="mt-3 text-3xl font-bold sm:text-4xl">Grow your friends circle</h1>
            <p class="mt-4 max-w-2xl text-sm text-white/80">
              Invite the people who make every event unforgettable, review invites at a glance, and discover new friends in seconds.
            </p>
          </div>
          <div class="flex flex-col gap-3 text-sm text-white/80">
            <div class="flex items-center gap-3 rounded-2xl border border-white/20 bg-white/10 px-4 py-3">
              <div class="icon-circle bg-white/20 text-white text-lg"><i class="fa-solid fa-user-group"></i></div>
              <div>
                <p class="text-xs uppercase tracking-[0.35em] text-white/70">Friends</p>
                <p class="text-lg font-semibold text-white"><%= pluralize(@friends.count, "connection") %></p>
              </div>
            </div>
            <%= link_to "Invite by tag", "#friends-search", class: "chip-link--primary px-7 py-3 text-xs uppercase tracking-[0.35em]" %>
          </div>
        </div>
      </header>

      <div class="grid gap-8 xl:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
        <div class="space-y-8">
          <section class="form-card space-y-6">
            <div class="form-card__header">
              <div>
                <p class="form-card__eyebrow">Your circle</p>
                <h2 class="form-card__title">Friends list</h2>
                <p class="form-card__subtitle">Stay in touch and keep your closest people one tap away.</p>
              </div>
              <span class="info-chip"><%= @friends.count %> total</span>
            </div>

            <% if @friends.any? %>
              <div class="grid gap-5 sm:grid-cols-2">
                <% @friends.each do |friend| %>
                  <div class="form-attachment__item">
                    <div class="flex items-center gap-4">
                      <% if friend.avatar.attached? %>
                        <%= image_tag friend.avatar.variant(resize_to_fill: [48, 48]),
                              class: "h-12 w-12 rounded-full border-2 border-white/60 object-cover shadow-lg" %>
                      <% else %>
                        <div class="avatar-stack__item h-12 w-12 border-2 border-white/60 text-brand">
                          <%= friend.first_name[0].upcase %>
                        </div>
                      <% end %>
                      <div>
                        <p class="font-semibold text-neutral-text"><%= friend.full_name %></p>
                        <p class="text-xs uppercase tracking-[0.35em] text-neutral-muted/80">@<%= friend.tag %></p>
                      </div>
                    </div>
                    <%= link_to "Remove",
                          friendship_path(friend),
                          method: :delete,
                          class: "chip-link text-xs uppercase tracking-[0.35em]" %>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="rounded-2xl border border-dashed border-brand-light/40 bg-white/70 px-6 py-8 text-center text-sm text-neutral-muted">
                <p class="font-semibold text-neutral-text">No friends yet</p>
                <p class="mt-2">Start by searching for a friend’s tag or inviting them to an event.</p>
              </div>
            <% end %>
          </section>

          <section class="form-card space-y-6">
            <div class="form-card__header">
              <div>
                <p class="form-card__eyebrow">Status</p>
                <h2 class="form-card__title">Requests you’ve sent</h2>
                <p class="form-card__subtitle">Keep tabs on invites waiting for approval.</p>
              </div>
              <span class="info-chip"><%= @pending_requests.count %> pending</span>
            </div>

            <% if @pending_requests.any? %>
              <div class="space-y-4">
                <% @pending_requests.each do |request| %>
                  <div class="form-attachment__item">
                    <div>
                      <p class="font-semibold text-neutral-text"><%= request.friend.full_name %></p>
                      <p class="text-xs uppercase tracking-[0.35em] text-neutral-muted/80">@<%= request.friend.tag %></p>
                      <p class="mt-2 inline-flex items-center gap-2 rounded-full bg-amber-100 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.35em] text-amber-600">
                        <i class="fa-regular fa-hourglass-half"></i>
                        Awaiting response
                      </p>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="text-sm text-neutral-muted">You have no outgoing requests right now.</p>
            <% end %>
          </section>

          <section class="form-card space-y-6">
            <div class="form-card__header">
              <div>
                <p class="form-card__eyebrow">Incoming</p>
                <h2 class="form-card__title">Friend invitations</h2>
                <p class="form-card__subtitle">Respond to new connections so they can join the fun.</p>
              </div>
              <span class="info-chip"><%= @invitations.count %> waiting</span>
            </div>

            <% if @invitations.any? %>
              <div class="space-y-4">
                <% @invitations.each do |request| %>
                  <div class="form-attachment__item">
                    <div>
                      <p class="font-semibold text-neutral-text"><%= request.user.full_name %></p>
                      <p class="text-xs uppercase tracking-[0.35em] text-neutral-muted/80">@<%= request.user.tag %></p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                      <%= button_to "Accept",
                            friendship_path(request, status: :accepted),
                            method: :patch,
                            class: "chip-link--primary px-6 py-2 text-[11px] uppercase tracking-[0.35em]" %>
                      <%= button_to "Decline",
                            friendship_path(request, status: :declined),
                            method: :patch,
                            class: "chip-link px-6 py-2 text-[11px] uppercase tracking-[0.35em]" %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="text-sm text-neutral-muted">No new invitations at the moment.</p>
            <% end %>
          </section>
        </div>

        <aside class="space-y-6">
          <div class="glass-panel space-y-4" id="friends-search">
            <h3 class="text-lg font-semibold text-neutral-text">Find friends by tag</h3>
            <p class="text-sm text-neutral-muted">Search their HappenHub tag and send a request instantly.</p>
            <form
              action="<%= search_users_path %>"
              method="get"
              data-turbo-frame="search_results"
              data-turbo="true"
              class="space-y-3"
            >
              <input
                type="text"
                name="q"
                placeholder="Search by tag..."
                class="form-input"
              >
              <button
                type="submit"
                class="chip-link--primary w-full justify-center px-6 py-3 text-xs uppercase tracking-[0.35em]"
              >
                Search
              </button>
            </form>
            <turbo-frame id="search_results" class="block rounded-2xl border border-white/30 bg-white/80 px-5 py-4 text-sm text-neutral-muted">
              <p>Enter a tag above to find a friend.</p>
            </turbo-frame>
          </div>

          <div class="glass-panel space-y-4">
            <div class="flex items-center gap-3">
              <div class="icon-circle text-xl">✨</div>
              <div>
                <h3 class="text-lg font-semibold text-neutral-text">Connection tips</h3>
                <p class="text-sm text-neutral-muted">Keep your circle active with shared events and follow-ups.</p>
              </div>
            </div>
            <ul class="space-y-3 text-sm text-neutral-muted">
              <li class="flex items-start gap-3">
                <span class="mt-1 h-2.5 w-2.5 rounded-full bg-brand"></span>
                Tag friends in event comments so everyone stays in the loop.
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1 h-2.5 w-2.5 rounded-full bg-brand"></span>
                Invite new acquaintances to low-key meetups to build trust.
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1 h-2.5 w-2.5 rounded-full bg-brand"></span>
                Celebrate milestones with quick shoutouts or shared photos.
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</div>
