<div class="max-w-4xl mx-auto px-6 py-8 animate-fade-in">
  <!-- Friends List -->
  <div class="bg-white shadow-md rounded-lg p-6">
    <h2 class="text-2xl font-semibold text-gray-800 mb-4">Friends List</h2>

    <% if @friends.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <% @friends.each do |friend| %>
          <div class="flex items-center justify-between bg-gray-50 hover:bg-gray-100 p-4 rounded-lg shadow-sm transition">
            <div class="flex items-center">
              <% if friend.avatar.attached? %>
                <%= image_tag friend.avatar.variant(resize_to_fill: [40, 40]),
                      class: "w-10 h-10 rounded-full object-cover ring-2 ring-white shadow" %>
              <% else %>
                <div class="bg-accent-red text-white w-10 h-10 flex items-center justify-center rounded-full text-lg font-bold ring-2 ring-white shadow">
                  <%= friend.first_name[0].upcase %>
                </div>
              <% end %>
              <div class="ml-3">
                <p class="font-semibold text-gray-900"><%= friend.full_name %></p>
                <p class="text-xs text-gray-500 font-mono">@<%= friend.tag %></p>
              </div>
            </div>
            <%= link_to "Remove", friendship_path(friend), method: :delete, class: "text-rose-600 hover:text-rose-800 text-sm font-medium transition" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center text-gray-500">
        <p>You haven’t added any friends yet.</p>
      </div>
    <% end %>
  </div>

  <!-- Pending Friend Requests -->
  <div class="bg-white shadow-md rounded-lg p-6 mt-8">
    <h2 class="text-2xl font-semibold text-gray-800 mb-4">Pending Friend Requests</h2>

    <% if @pending_requests.any? %>
      <div class="space-y-4">
        <% @pending_requests.each do |request| %>
          <div class="flex justify-between items-center bg-gray-50 hover:bg-gray-100 p-4 rounded-lg shadow-sm transition">
            <div>
              <p class="font-semibold text-gray-900"><%= request.friend.full_name %></p>
              <p class="text-xs text-gray-500 font-mono">@<%= request.friend.tag %></p>
              <p class="text-xs text-yellow-600 mt-1 font-semibold">Pending</p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-center">No pending friend requests.</p>
    <% end %>
  </div>

  <!-- Pending Invitations -->
  <div class="bg-white shadow-md rounded-lg p-6 mt-8">
    <h2 class="text-2xl font-semibold text-gray-800 mb-4">Pending Invitations</h2>

    <% if @invitations.any? %>
      <div class="space-y-4">
        <% @invitations.each do |request| %>
          <div class="flex justify-between items-center bg-gray-50 hover:bg-gray-100 p-4 rounded-lg shadow-sm transition">
            <div>
              <p class="font-semibold text-gray-900"><%= request.user.full_name %></p>
              <p class="text-xs text-gray-500 font-mono">@<%= request.user.tag %></p>
            </div>
            <div class="flex space-x-2">
              <%= button_to "Accept", friendship_path(request, status: :accepted),
                    method: :patch,
                    class: "bg-emerald-500 hover:bg-emerald-600 text-white px-3 py-1 rounded-lg text-sm transition" %>
              <%= button_to "Decline", friendship_path(request, status: :declined),
                    method: :patch,
                    class: "bg-rose-500 hover:bg-rose-600 text-white px-3 py-1 rounded-lg text-sm transition" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-center">No pending invitations.</p>
    <% end %>
  </div>

  <!-- Find Friends by Tag -->
  <div class="bg-white shadow-md rounded-lg p-6 mt-8">
    <h2 class="text-2xl font-semibold text-gray-800 mb-4">Find Friends by Tag</h2>

    <form
      action="<%= search_users_path %>"
      method="get"
      data-turbo-frame="search_results"
      data-turbo="true"
      class="flex items-center gap-4"
    >
      <input
        type="text"
        name="q"
        placeholder="Search by tag..."
        class="flex-grow border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-accent-red focus:border-accent-red transition"
      >
      <button
        type="submit"
        class="bg-accent-red text-white px-4 py-2 rounded-lg hover:bg-red-600 transition"
      >
        Search
      </button>
    </form>

    <turbo-frame id="search_results" class="mt-6">
      <p class="text-sm text-gray-500">Enter a tag above to find a friend.</p>
    </turbo-frame>
  </div>
</div>
