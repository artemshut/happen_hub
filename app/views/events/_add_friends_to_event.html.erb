<% event ||= @event %>
<% friends ||= [] %>
<% friend_availabilities ||= {} %>

<div
  class="space-y-6"
  data-controller="invitee-availability"
  data-invitee-availability-url-value="<%= availability_preview_event_path(event) %>"
  data-action="availability:update->invitee-availability#refresh">
  <div class="flex flex-col gap-3">
    <div class="icon-circle text-lg">🤝</div>
    <div>
      <h2 class="text-xl font-bold text-neutral-text">Add friends to this event</h2>
      <p class="text-sm text-neutral-muted">
        Handpick attendees and preview availability before sending invites.
      </p>
    </div>
  </div>
  <turbo-frame id="friend_invite_list">
    <%= render partial: "events/friend_invite_list",
               locals: {
                 event: event,
                 friends: friends,
                 friend_availabilities: friend_availabilities
               } %>
  </turbo-frame>
</div>
