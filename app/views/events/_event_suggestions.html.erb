<div class="tab-content hidden" id="tab-suggestions">
  <!-- Suggest New Time -->
  <details class="mb-6">
    <summary class="cursor-pointer text-accent-red font-semibold hover:underline transition">+ Suggest New Time</summary>
    <div class="mt-4">
      <%= render partial: "event_suggestions/form", locals: { event: @event } %>
    </div>
  </details>

  <!-- Suggestions List -->
  <h3 class="text-xl font-semibold mb-4 text-gray-800">Suggestions</h3>

  <div id="suggestions_list" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    <%- @event.event_suggestions.each do |suggestion| %>
      <%= render partial: "event_suggestions/event_suggestion", locals: { suggestion: suggestion, event: @event } %>
    <% end %>
  </div>
</div>
