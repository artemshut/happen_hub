<% allowed_manage = policy(event).update? %>
<% items = checklist.items.includes(:assignee) %>
<% total = items.size %>
<% completed = items.count(&:completed?) %>
<% progress = total.positive? ? ((completed.to_f / total) * 100).round : 0 %>
<% alert_message ||= nil %>
<% sortable_actions = "dragstart->sortable#dragstart dragover->sortable#dragover drop->sortable#drop dragend->sortable#dragend" %>

<div class="glass-panel space-y-5">
  <% if alert_message.present? %>
    <div class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
      <%= alert_message %>
    </div>
  <% end %>
  <div class="flex flex-wrap items-center gap-3">
    <div class="icon-circle text-lg">🧾</div>
    <div>
      <h3 class="text-xl font-bold text-neutral-text"><%= checklist.title %></h3>
      <p class="text-sm text-neutral-muted">
        <%= total.positive? ? "#{completed}/#{total} tasks complete" : "No tasks yet" %>
      </p>
    </div>
    <% if allowed_manage && checklist.persisted? %>
      <div class="flex items-center gap-2 ml-auto">
        <div class="cursor-grab px-2 text-lg text-neutral-muted" title="Drag to reorder">
          <i class="fa-solid fa-grip-vertical"></i>
        </div>
        <%= link_to "Rename", edit_event_checklist_path(event, checklist),
              class: "chip-link px-3 py-1 text-[10px]",
              data: { turbo_frame: dom_id(checklist, :panel) } %>
        <%= button_to "Delete",
              event_checklist_path(event, checklist),
              method: :delete,
              form: { data: { turbo_frame: "event_checklists_panel", turbo_confirm: "Remove this checklist and its tasks?" } },
              class: "chip-link px-3 py-1 text-[10px]" %>
      </div>
    <% end %>
  </div>

  <div class="space-y-2">
    <div class="flex items-center justify-between text-sm text-neutral-muted">
      <span>Progress</span>
      <span><%= progress %>%</span>
    </div>
    <div class="h-2 w-full overflow-hidden rounded-full bg-neutral-border">
      <div class="h-full rounded-full bg-gradient-to-r from-brand via-brand-dark to-indigo-500 transition-all duration-500" style="width: <%= progress %>%"></div>
    </div>
  </div>

  <div class="space-y-3">
    <% if items.any? %>
      <%= content_tag :ul,
            class: "space-y-3",
            data: (allowed_manage ? { controller: "sortable", action: sortable_actions } : nil) do %>
        <% items.each do |item| %>
          <%= render "events/checklist_item", event:, checklist:, item:, draggable: allowed_manage %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <% if allowed_manage && checklist.persisted? %>
    <div class="rounded-2xl border border-dashed border-brand-light/60 bg-white/70 p-4">
      <%= form_with(model: [ event, checklist, EventChecklistItem.new ], url: event_checklist_items_path(event, checklist), class: "space-y-3", data: { turbo_frame: dom_id(checklist, :panel) }) do |form| %>
        <div class="grid gap-4 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)]">
          <div>
            <%= form.label :title, "Task", class: "form-label" %>
            <%= form.text_field :title, placeholder: "Confirm caterer...", class: "form-input" %>
          </div>
          <div>
            <%= form.label :due_at, "Due", class: "form-label" %>
            <%= form.datetime_field :due_at, class: "form-input" %>
          </div>
          <div>
            <%= form.label :assignee_id, "Owner", class: "form-label" %>
            <%= form.select :assignee_id,
                  options_for_select(checklist_assignment_options(event)),
                  { include_blank: "Unassigned" },
                  class: "form-input" %>
          </div>
        </div>
        <%= form.submit "Add task", class: "chip-link--primary px-5 py-2 text-xs uppercase tracking-[0.35em]" %>
      <% end %>
    </div>
  <% end %>
</div>
