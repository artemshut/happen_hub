<details class="bg-white rounded-lg shadow-md p-4 mt-6 animate-fade-in transition">
  <summary class="cursor-pointer font-semibold text-accent-red text-lg">📎 Files</summary>

  <% if event.files.attached? %>
    <ul class="mt-3 space-y-2 text-sm text-gray-700">
      <% event.files.each do |file| %>
        <li class="flex justify-between items-center border border-gray-200 rounded px-3 py-2 bg-gray-50">
          <div class="flex items-center gap-2">
            <span><%= attachment_icon_for(file) %></span>
            <span class="truncate max-w-[12rem]" title="<%= file.filename.to_s %>"><%= file.filename.to_s.truncate(30) %></span>
          </div>

          <div class="flex gap-3 items-center">
            <%= link_to "Download", rails_blob_path(file, disposition: "attachment"),
                        class: "text-blue-600 hover:underline text-sm" %>
            <%= button_to "Remove", file_event_path(event, file_id: file.id),
                          method: :delete,
                          form: { data: { turbo_stream: true } },
                          class: "text-red-600 text-xs hover:underline" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-gray-500">No files uploaded yet.</p>
  <% end %>
</details>
