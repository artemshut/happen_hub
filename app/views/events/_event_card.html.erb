<div class="relative rounded-[2rem] border border-white/40 bg-white/70 pb-6 shadow-[0_30px_80px_rgba(15,23,42,0.12)] backdrop-blur-xl transition hover:-translate-y-1 hover:shadow-[0_40px_110px_rgba(147,51,234,0.18)]">
  <% if event.owned_by?(current_user) %>
    <div class="absolute right-5 top-5 z-20">
      <%= button_to event_path(event),
            method: :delete,
            data: { turbo: false, confirm: "Delete event?" },
            class: "inline-flex items-center gap-2 rounded-full bg-white/80 px-4 py-1 text-[11px] font-semibold uppercase tracking-[0.35em] text-brand hover:bg-white" do %>
        <i class="fa-regular fa-trash-can"></i>
        Remove
      <% end %>
    </div>
  <% end %>

  <%= link_to event_path(event), data: { turbo: false }, class: "relative block h-56 overflow-hidden rounded-t-[2rem]" do %>
    <% if event.cover_image.attached? %>
      <%= image_tag event.cover_image.variant(resize_to_fill: [800, 420]),
            class: "absolute inset-0 h-full w-full object-cover" %>
    <% else %>
      <%= image_tag "default_event.jpg", class: "absolute inset-0 h-full w-full object-cover opacity-90" %>
    <% end %>
    <div class="absolute inset-0 bg-gradient-to-t from-neutral-text/80 via-neutral-text/20 to-transparent"></div>
    <div class="relative flex h-full flex-col justify-end gap-4 px-6 pb-6 text-white">
      <div class="flex flex-wrap items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.35em] text-white/70">
        <% if event.event_category.present? %>
          <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1">
            <span><%= event.event_category.emoji %></span>
            <%= event.event_category.name %>
          </span>
        <% end %>
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1">
          <i class="fa-regular fa-clock"></i>
          <%= formatted_event_date(event.start_time) %>
        </span>
      </div>
      <div class="space-y-2">
        <h2 class="text-2xl font-semibold leading-tight sm:text-3xl"><%= event.title %></h2>
        <% description_text = event.description&.to_plain_text.presence || "" %>
        <% if description_text.present? %>
          <p class="text-sm text-white/75"><%= truncate(description_text.strip, length: 140) %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="space-y-5 px-6 pt-6">
    <div class="flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-[0.35em] text-neutral-muted/80">
      <span class="inline-flex items-center gap-2 rounded-full bg-brand-soft/80 px-3 py-1 text-brand">
        <i class="fa-solid fa-location-dot"></i>
        <%= event.location.present? ? strip_tags(event.location.to_s) : "Location coming soon" %>
      </span>
      <span class="inline-flex items-center gap-2">
        <i class="fa-solid fa-user-group text-brand"></i>
        <%= pluralize(event.participant_count, "guest") %>
      </span>
      <span class="inline-flex items-center gap-2">
        <i class="fa-solid fa-eye text-brand"></i>
        <%= event.visibility.titleize %>
      </span>
    </div>

    <div class="mt-5 flex flex-wrap gap-3">
      <%= link_to "View details",
            event_path(event),
            data: { turbo: false },
            class: "inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-gradientFrom to-brand-gradientTo px-6 py-2 text-[11px] font-semibold uppercase tracking-[0.35em] text-white shadow-[0_20px_45px_rgba(147,51,234,0.35)] hover:-translate-y-0.5 transition" %>
      <% if event.owned_by?(current_user) %>
        <%= link_to "Edit",
              edit_event_path(event),
              data: { turbo: false },
              class: "inline-flex items-center gap-2 rounded-full border border-brand-light/40 bg-white/90 px-6 py-2 text-[11px] font-semibold uppercase tracking-[0.35em] text-brand transition hover:-translate-y-0.5" %>
      <% else %>
        <%= link_to "RSVP",
              event_path(event),
              data: { turbo: false },
              class: "inline-flex items-center gap-2 rounded-full border border-brand-light/40 bg-white/90 px-6 py-2 text-[11px] font-semibold uppercase tracking-[0.35em] text-brand transition hover:-translate-y-0.5" %>
      <% end %>
    </div>
  </div>
</div>
