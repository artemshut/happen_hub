<div class="border border-gray-300 rounded-lg shadow-md bg-white overflow-hidden">
  <% if event.cover_image.attached? %>
    <%= image_tag event.cover_image.variant(resize_to_fill: [600, 200]),
          class: "w-full h-48 object-cover" %>
  <% else %>
    <%= image_tag "default_event.jpg", class: "w-full h-48 object-cover" %>
  <% end %>

  <div class="p-4">
    <h2 class="text-xl font-semibold text-accent-red mb-2">
      <%= link_to event.title, event_path(event), class: "hover:underline" %>
    </h2>
    <p class="text-gray-700"><strong>Date:</strong> <%= formatted_event_date(event.start_time) %></p>
    <p class="text-gray-700 mb-2"><strong>Location:</strong> <%= event.location %></p>

    <div class="mt-4 flex gap-2">
      <%= link_to "View Details", event_path(event),
            class: "bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded" %>
      <% if event.owned_by?(current_user) %>
        <%= link_to "Edit", edit_event_path(event),
              class: "bg-gray-100 hover:bg-gray-200 text-red-500 font-semibold py-2 px-4 rounded border border-red-300" %>
      <% end %>
    </div>
  </div>
</div>
