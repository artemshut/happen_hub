<% content_for :main_classes, "relative flex-grow overflow-x-hidden pb-12" %>

<div class="full-bleed overflow-hidden bg-neutral-bg pb-16">
  <section class="landing-section">
    <div class="space-y-14">
      <header class="rounded-[2.5rem] border border-white/40 bg-white/70 p-10 shadow-[0_45px_120px_rgba(147,51,234,0.18)] backdrop-blur-2xl">
        <div class="grid gap-12 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:items-center">
          <div class="space-y-8">
            <span class="inline-flex items-center gap-2 rounded-full bg-brand-soft/80 px-4 py-2 text-xs font-semibold uppercase tracking-[0.45em] text-brand-dark">Plan with ease</span>
            <div class="space-y-4">
              <h1 class="text-4xl font-bold leading-tight text-neutral-text sm:text-5xl">Curate unforgettable moments</h1>
              <p class="text-base text-neutral-muted max-w-2xl">
                Scan upcoming gatherings, remix the vibe with filters, and jump straight into details—all wrapped in a flow that feels like your best event invite.
              </p>
            </div>
            <div class="flex flex-wrap gap-4">
              <%= link_to "Create event", new_event_path,
                    class: "landing-cta-primary px-10 py-3 text-sm uppercase tracking-[0.35em]" %>
              <%= link_to "View calendar", dashboard_path,
                    class: "landing-cta-secondary px-10 py-3 text-sm uppercase tracking-[0.35em]" %>
            </div>
          </div>
          <div class="grid gap-6 sm:grid-cols-2">
            <div class="rounded-3xl border border-brand-light/40 bg-white/90 px-6 py-5 shadow-[0_25px_60px_rgba(147,51,234,0.15)]">
              <p class="text-xs uppercase tracking-[0.35em] text-neutral-muted/80">Total events</p>
              <p class="mt-4 text-4xl font-semibold text-brand"><%= @events.total_count %></p>
              <p class="mt-2 text-xs text-neutral-muted">Across every category you follow.</p>
            </div>
            <div class="rounded-3xl border border-brand-light/40 bg-white/90 px-6 py-5 shadow-[0_25px_60px_rgba(236,72,153,0.15)]">
              <p class="text-xs uppercase tracking-[0.35em] text-neutral-muted/80">Next up</p>
              <% next_event = @events.respond_to?(:first) ? @events.first : nil %>
              <% if next_event.present? %>
                <p class="mt-4 text-lg font-semibold text-neutral-text"><%= formatted_event_date(next_event.start_time) %></p>
                <p class="mt-1 text-sm text-neutral-muted">Hosted by <%= next_event.user.first_name %></p>
              <% else %>
                <p class="mt-4 text-lg font-semibold text-neutral-text">No events scheduled</p>
                <p class="mt-1 text-sm text-neutral-muted">Spin up the next gathering.</p>
              <% end %>
            </div>
          </div>
        </div>
      </header>

      <turbo-frame id="events_list" class="block mt-10">
        <% selected_category_id = params[:category_id].presence&.to_i %>
        <div class="space-y-8">
          <div class="rounded-[2.25rem] border border-white/40 bg-white/80 p-6 shadow-[0_35px_90px_rgba(15,23,42,0.12)] backdrop-blur-xl">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div class="space-y-2">
                <p class="text-xs uppercase tracking-[0.35em] text-neutral-muted/80">Browse</p>
                <h2 class="text-xl font-semibold text-neutral-text">Pick a category</h2>
              </div>
              <% if selected_category_id.present? %>
                <% current_category = @event_categories.detect { |cat| cat.id == selected_category_id } %>
                <% if current_category %>
                  <span class="inline-flex items-center gap-2 rounded-full bg-brand-soft/90 px-4 py-1 text-xs font-semibold uppercase tracking-[0.35em] text-brand">
                    <%= current_category.emoji %> <%= current_category.name %>
                  </span>
                <% end %>
              <% end %>

            <div class="mt-6 flex gap-3 overflow-x-auto pb-2">
              <%= link_to events_path,
                          data: { turbo_frame: "events_list" },
                          class: "inline-flex items-center gap-2 whitespace-nowrap rounded-full px-6 py-2 text-xs font-semibold uppercase tracking-[0.35em] transition #{selected_category_id.nil? ? 'bg-gradient-to-r from-brand-gradientFrom to-brand-gradientTo text-white shadow-[0_18px_45px_rgba(147,51,234,0.35)]' : 'bg-white/80 text-brand border border-brand-light/30'}" do %>
                All
              <% end %>

              <% @event_categories.each do |category| %>
                <% active = selected_category_id == category.id %>
                <%= link_to events_path(category_id: category.id),
                            data: { turbo_frame: "events_list" },
                            class: "inline-flex items-center gap-2 whitespace-nowrap rounded-full px-6 py-2 text-xs font-semibold uppercase tracking-[0.35em] transition #{active ? 'bg-gradient-to-r from-brand-gradientFrom to-brand-gradientTo text-white shadow-[0_18px_45px_rgba(236,72,153,0.35)]' : 'bg-white/80 text-brand border border-brand-light/30'}" do %>
                  <%= "#{category.emoji} #{category.name}" %>
                <% end %>
              <% end %>
            </div>
          </div>

          <%= render partial: "events/events_list", locals: { events: @events } %>
        </div>
      </turbo-frame>
    </div>
  </section>
</div>
