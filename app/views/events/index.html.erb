<h1 class="text-3xl font-bold mb-6">Your Events</h1>

<% if @events.any? %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @events.each do |event| %>
      <div class="border border-gray-300 rounded-lg shadow-md p-4 bg-white">
        <h2 class="text-xl font-semibold text-accent-red mb-2">
          <%= link_to event.title, event_path(event), class: "hover:underline" %>
        </h2>
        <p class="text-gray-700">
          <strong>Date:</strong> <%= formatted_event_date(event.start_time) %>
        </p>
        <p class="text-gray-700 mb-2">
          <strong>Location:</strong> <%= event.location %>
        </p>
        <div class="mt-4 flex gap-2">
          <%= link_to "View Details", event_path(event),
                class: "bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded" %>

          <% if event.owned_by?(current_user) %>
            <%= link_to "Edit", edit_event_path(event),
                  class: "bg-gray-100 hover:bg-gray-200 text-red-500 font-semibold py-2 px-4 rounded border border-red-300" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-gray-700">You have no events at the moment. <%= link_to 'Create an Event', new_event_path, class: "text-accent-red hover:underline" %>.</p>
<% end %>