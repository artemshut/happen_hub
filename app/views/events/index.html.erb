<turbo-frame id="events_list">
  <!-- Filters -->
  <div class="flex flex-wrap gap-2 mb-6">
    <% selected_category_id = params[:category_id].presence&.to_i %>

    <%= link_to events_path,
                data: { turbo_frame: "events_list" },
                class: "px-3 py-1 text-sm rounded-full shadow-sm transition
                       #{selected_category_id.nil? ? 'bg-accent-violet text-white' : 'bg-gray-100 text-gray-800 hover:bg-gray-200'}" do %>
      All
    <% end %>

    <% @event_categories.each do |category| %>
      <%= link_to events_path(category_id: category.id),
                  data: { turbo_frame: "events_list" },
                  class: "px-3 py-1 text-sm rounded-full shadow-sm transition
                         #{selected_category_id == category.id ? 'bg-accent-violet text-white' : 'bg-gray-100 text-gray-800 hover:bg-gray-200'}" do %>
        <%= "#{category.emoji} #{category.name}" %>
      <% end %>
    <% end %>
  </div>

  <!-- Events List -->
  <%= render partial: "events/events_list", locals: { events: @events } %>
</turbo-frame>
