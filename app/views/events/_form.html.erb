<div class="max-w-2xl mx-auto px-4 py-6 bg-white shadow rounded-lg">
  <div class="mb-4">
    <h2 class="text-2xl font-bold"><%= @event.persisted? ? "Edit #{@event.title}" : "New Event" %></h2>
  </div>

  <%= form_with(model: @event, local: true, html: { multipart: true }) do |form| %>
    <div class="mb-4">
      <%= form.label :title, class: "block text-gray-700 font-bold mb-2" %>
      <%= form.text_field :title, required: true, class: "w-full border border-gray-300 rounded px-4 py-2 focus:ring-2 focus:ring-accent-red" %>
    </div>
    <div class="mb-4">
      <%= form.label :description, class: "block text-gray-700 font-bold mb-2" %>
      <%= form.rich_text_area :description, class: "w-full border border-gray-300 rounded focus:ring-2 focus:ring-accent-red" %>
    </div>
    <div data-controller="datetime-link">
      <div class="mb-4">
        <%= form.label :start_time, "Start Time", class: "block text-sm font-medium text-gray-700" %>
        <%= form.datetime_local_field :start_time,
              data: {
                datetime_link_target: "start",
                action: "change->datetime-link#handleStartChange"
              },
              class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring focus:ring-blue-200" %>
      </div>

      <div class="mb-4">
        <%= form.label :end_time, "End Time", class: "block text-sm font-medium text-gray-700" %>
        <%= form.datetime_local_field :end_time,
              data: { datetime_link_target: "end" },
              class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring focus:ring-blue-200" %>
      </div>
    </div>

    <div data-controller="location-autocomplete"
      data-location-autocomplete-target="container">

      <div class="mb-4">
        <label>Location</label>
        <input type="text"
              name="event[location]"
              class="input"
              data-location-autocomplete-target="input"
              id="autocomplete-location"
              value="<%= @event.location %>">
      </div>

      <input type="hidden"
            name="event[latitude]"
            data-location-autocomplete-target="lat"
            value="<%= @event.latitude %>" />

      <input type="hidden"
            name="event[longitude]"
            data-location-autocomplete-target="lng"
            value="<%= @event.longitude %>" />
    </div>

    <div class="mb-4">
      <%= form.label :cover_image %>
      <%= form.file_field :cover_image %>
    </div>

    <div class="mb-4">
      <label for="event_event_category_id" class="block text-sm font-medium text-gray-700 mb-1">
        Category
      </label>
      <div class="relative">
        <%= form.collection_select :event_category_id, @event_categories, :id, :name,
              { prompt: "Choose a category" },
              class: "block w-full border border-gray-300 rounded-lg shadow-sm px-4 py-2 pr-10 bg-white focus:outline-none focus:ring-2 focus:ring-accent-red focus:border-accent-red transition" %>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-gray-400">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </div>
    
    <div class="mb-4">
      <%= form.label :visibility, "Who can see this event?", class: "block text-gray-700 font-bold mb-2" %>
      <%= form.select :visibility, Event.visibilities.keys.map { |v| [v.titleize, v] }, {}, 
          class: "w-full border border-gray-300 rounded px-4 py-2 focus:ring-2 focus:ring-accent-red" %>
    </div>

    <div class="mt-4 flex gap-2">
      <%= link_to "Back to Events", events_path,
            class: "bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2 px-4 rounded border" %>
      <%= form.submit "Save", class: "bg-accent-pink text-white px-4 py-2 rounded hover:bg-red-600 cursor-pointer" %>
    </div>
  <% end %>
</div>
