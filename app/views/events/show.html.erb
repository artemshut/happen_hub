<% content_for :main_classes, "relative flex-grow overflow-x-hidden pb-20" %>
<% host = @event.user %>
<% category = @event.event_category %>
<% duration = if @event.start_time.present? && @event.end_time.present?
                distance_of_time_in_words(@event.start_time, @event.end_time)
              end %>
<% share_url = "#{request.base_url}#{share_event_path(@event.share_token)}" %>

<div class="full-bleed overflow-hidden bg-gradient-to-br from-brand-soft/30 via-neutral-bg to-neutral-bg pb-16">
  <div class="landing-bubble w-[28rem] h-[28rem] -left-24 top-0 animate-floatSlow"></div>
  <div class="landing-bubble w-[22rem] h-[22rem] right-0 top-24 animate-floatSlow" style="animation-delay: 1.6s;"></div>
  <div class="landing-bubble w-[30rem] h-[30rem] -bottom-40 left-1/3 animate-pulseRing opacity-20"></div>

  <section class="landing-section pt-28 md:pt-36">
    <div class="space-y-12">
      <div class="grid grid-cols-1 gap-10 xl:grid-cols-[minmax(0,1.7fr)_minmax(0,1.1fr)]">
        <div class="space-y-8">
          <div class="glass-panel p-0 overflow-hidden">
            <div class="relative h-80 md:h-96">
              <% if @event.cover_image.attached? %>
                <%= image_tag @event.cover_image.variant(resize_to_fill: [1400, 560]),
                      class: "absolute inset-0 h-full w-full object-cover" %>
              <% else %>
                <%= image_tag "default_event.jpg", class: "absolute inset-0 h-full w-full object-cover opacity-80" %>
              <% end %>
              <div class="absolute inset-0 bg-gradient-to-br from-neutral-text/80 via-neutral-text/30 to-transparent"></div>
              <div class="relative flex h-full flex-col justify-end gap-5 p-8 text-white">
                <div class="flex flex-wrap items-center gap-3 text-sm uppercase tracking-[0.35em] text-white/70">
                  <% if category.present? %>
                    <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 font-semibold">
                      <span class="text-lg"><%= category.emoji %></span>
                      <%= category.name %>
                    </span>
                  <% end %>
                  <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 font-semibold">
                    <i class="fa-regular fa-clock"></i>
                    <%= formatted_event_date(@event.start_time) %>
                  </span>
                </div>
                <h1 class="text-3xl font-extrabold leading-tight sm:text-4xl md:text-5xl">
                  <%= @event.title %>
                </h1>
                <div class="flex flex-wrap items-center gap-5 text-sm text-white/80">
                  <div class="flex items-center gap-3">
                    <% if host.avatar.attached? %>
                      <%= image_tag host.avatar.variant(resize_to_fill: [48, 48]),
                            class: "h-12 w-12 rounded-full border-2 border-white/40 object-cover shadow-lg" %>
                    <% else %>
                      <div class="avatar-stack__item h-12 w-12 border-2 border-white/40 text-white shadow-lg">
                        <%= host.first_name[0].upcase %>
                      </div>
                    <% end %>
                    <div>
                      <p class="font-semibold text-white">Hosted by <%= host.full_name %></p>
                      <p class="text-xs uppercase tracking-[0.35em] text-white/70"><%= host.username %></p>
                    </div>
                  </div>
                  <% if duration.present? %>
                    <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.35em]">
                      <i class="fa-solid fa-hourglass-half"></i>
                      <%= duration %>
                    </span>
                  <% end %>
                  <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.35em]">
                    <i class="fa-solid fa-eye"></i>
                    <%= @event.visibility.titleize %>
                  </span>
                </div>
              </div>
            </div>

            <div class="grid gap-4 bg-white/90 p-6 sm:grid-cols-3">
              <div class="rounded-2xl border border-brand-light/30 bg-white/80 p-4">
                <p class="text-xs uppercase tracking-[0.35em] text-neutral-muted">Starts</p>
                <p class="mt-2 text-sm font-semibold text-neutral-text"><%= formatted_event_date(@event.start_time) %></p>
              </div>
              <div class="rounded-2xl border border-brand-light/30 bg-white/80 p-4">
                <p class="text-xs uppercase tracking-[0.35em] text-neutral-muted">Location</p>
                <p class="mt-2 text-sm font-semibold text-neutral-text">
                  <%= @event.location.present? ? strip_tags(@event.location.to_s) : "To be announced" %>
                </p>
              </div>
              <div class="rounded-2xl border border-brand-light/30 bg-white/80 p-4">
                <p class="text-xs uppercase tracking-[0.35em] text-neutral-muted">Guests</p>
                <p class="mt-2 text-sm font-semibold text-neutral-text">
                  <%= pluralize(@event.participant_count, "person") %> invited
                </p>
              </div>
            </div>
          </div>

          <div class="glass-panel space-y-6">
            <div class="flex items-center gap-3">
              <div class="icon-circle text-lg">🗓️</div>
              <div>
                <h2 class="text-xl font-bold text-neutral-text">Schedule</h2>
                <p class="text-sm text-neutral-muted">All the timings so your guests stay perfectly in sync.</p>
              </div>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="rounded-2xl border border-brand-light/30 bg-white/90 p-4">
                <p class="text-xs uppercase tracking-[0.35em] text-neutral-muted">Starts</p>
                <p class="mt-2 text-base font-semibold text-neutral-text"><%= formatted_event_date(@event.start_time) %></p>
              </div>
              <div class="rounded-2xl border border-brand-light/30 bg-white/90 p-4">
                <p class="text-xs uppercase tracking-[0.35em] text-neutral-muted">Ends</p>
                <p class="mt-2 text-base font-semibold text-neutral-text"><%= formatted_event_date(@event.end_time) %></p>
              </div>
            </div>
            <% if duration.present? %>
              <p class="rounded-2xl border border-dashed border-brand-light/40 bg-brand-soft/40 px-4 py-3 text-sm text-neutral-muted">
                Expect around <span class="font-semibold text-brand-dark"><%= duration %></span> of shared moments together.
              </p>
            <% end %>
          </div>

          <% if @event.timeline_segments? || policy(@event).update? %>
            <%= render "events/sub_event_timeline", event: @event %>
          <% end %>

          <div class="glass-panel space-y-6">
            <div class="flex items-center gap-3">
              <div class="icon-circle text-lg">📖</div>
              <div>
                <h2 class="text-xl font-bold text-neutral-text">About this experience</h2>
                <p class="text-sm text-neutral-muted">Set the scene, highlight the vibe, and tease what’s to come.</p>
              </div>
            </div>
            <div class="prose prose-lg max-w-none text-neutral-muted">
              <%= render_rich_text_with_embeds(@event.description) %>
            </div>
          </div>

          <%= render "events/files_panel", event: @event %>

          <%= render partial: "events/invitation_status_full",
                     locals: {
                       event: @event,
                       viewer: current_user,
                       participants_by_status: @participants_by_status,
                       participant_count: @participant_count
                     } %>

          <div class="glass-panel space-y-6">
            <div class="flex items-center gap-3">
              <div class="icon-circle text-lg">🎯</div>
              <div>
                <h2 class="text-xl font-bold text-neutral-text">Coordinate invites</h2>
                <p class="text-sm text-neutral-muted">
                  Drop in friends, capture fresh suggestions, and loop in groups without cluttering the page.
                </p>
              </div>
            </div>

            <div class="flex flex-wrap gap-3">
              <div data-controller="modal">
                <button type="button" class="chip-link--primary px-6 py-3 text-xs uppercase tracking-[0.35em]" data-action="modal#open">
                  Add friends
                </button>
                <div class="modal-backdrop hidden opacity-0 pointer-events-none" data-modal-target="backdrop">
                  <div class="modal-panel pointer-events-none opacity-0 -translate-y-6" data-modal-target="dialog">
                    <button type="button" class="chip-link absolute right-6 top-6 text-[10px]" data-modal-target="close">
                      <i class="fa-solid fa-xmark"></i>
                      Close
                    </button>
                    <div class="mt-8">
                      <%= render "events/add_friends_to_event",
                                event: @event,
                                friends: @friends,
                                friend_availabilities: @friend_availabilities %>
                    </div>
                  </div>
                </div>
              </div>

              <div data-controller="modal">
                <button type="button" class="chip-link px-6 py-3 text-xs uppercase tracking-[0.35em]" data-action="modal#open">
                  Suggestions
                </button>
                <div class="modal-backdrop hidden opacity-0 pointer-events-none" data-modal-target="backdrop">
                  <div class="modal-panel pointer-events-none opacity-0 -translate-y-6" data-modal-target="dialog">
                    <button type="button" class="chip-link absolute right-6 top-6 text-[10px]" data-modal-target="close">
                      <i class="fa-solid fa-xmark"></i>
                      Close
                    </button>
                    <div class="mt-8">
                      <%= render "events/event_suggestions", event: @event %>
                    </div>
                  </div>
                </div>
              </div>

              <div data-controller="modal">
                <button type="button" class="chip-link px-6 py-3 text-xs uppercase tracking-[0.35em]" data-action="modal#open">
                  Invite groups
                </button>
                <div class="modal-backdrop hidden opacity-0 pointer-events-none" data-modal-target="backdrop">
                  <div class="modal-panel pointer-events-none opacity-0 -translate-y-6" data-modal-target="dialog">
                    <button type="button" class="chip-link absolute right-6 top-6 text-[10px]" data-modal-target="close">
                      <i class="fa-solid fa-xmark"></i>
                      Close
                    </button>
                    <div class="mt-8">
                      <%= render "events/group_invitations", event: @event %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <%= render "shared/map_view", event: @event %>
        </div>

        <div class="space-y-6 xl:pl-4">
          <div class="glass-panel space-y-4"
               data-controller="share"
               data-share-url-value="<%= share_url %>"
               data-share-track-url-value="<%= share_event_track_path(@event.share_token) %>"
               data-share-title-value="Join <%= @event.title %>"
               data-share-text-value="Check out this event on HappenHub">
            <div class="share-card__header">
              <div>
                <p class="form-card__eyebrow text-brand-dark">Share</p>
                <h3 class="text-lg font-semibold text-neutral-text">Invite anyone</h3>
              </div>
              <div class="share-card__metrics">
                <span><i class="fa-regular fa-eye"></i> <%= @event.share_views %> views</span>
                <span><i class="fa-solid fa-arrow-up-right-from-square"></i> <%= @event.share_clicks %> shares</span>
              </div>
            </div>
            <p class="text-sm text-neutral-muted">
              Send a private invite link or share directly to your favorite apps. Guests can browse the invite even without an account.
            </p>
            <div class="share-card__url">
              <span class="truncate"><%= share_url %></span>
              <button type="button"
                      class="chip-link px-4 py-2 text-[11px] uppercase tracking-[0.35em]"
                      data-action="share#copy">
                Copy
              </button>
            </div>
            <div class="flex flex-wrap gap-3">
              <button type="button"
                      class="chip-link--primary px-6 py-3 text-xs uppercase tracking-[0.35em]"
                      data-action="share#nativeShare">
                Share
              </button>
              <%= link_to "Preview invite",
                    share_event_path(@event.share_token),
                    class: "chip-link px-6 py-3 text-xs uppercase tracking-[0.35em]",
                    target: "_blank",
                    rel: "noopener" %>
            </div>
            <p class="text-xs text-neutral-muted" data-share-target="feedback"></p>
          </div>

          <div class="glass-panel space-y-6">
            <div class="flex items-center gap-3">
              <div class="icon-circle text-lg">🧭</div>
              <div>
                <h2 class="text-xl font-bold text-neutral-text">Host overview</h2>
                <p class="text-sm text-neutral-muted">
                  Everything guests need to trust the experience.
                </p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <% if host.avatar.attached? %>
                <%= image_tag host.avatar.variant(resize_to_fill: [60, 60]),
                      class: "h-16 w-16 rounded-full border-2 border-brand-light object-cover shadow-lg" %>
              <% else %>
                <div class="avatar-stack__item h-16 w-16 rounded-full text-xl">
                  <%= host.first_name[0].upcase %>
                </div>
              <% end %>
              <div>
                <p class="text-lg font-semibold text-neutral-text"><%= host.full_name %></p>
                <p class="text-xs uppercase tracking-[0.35em] text-neutral-muted"><%= host.username %></p>
              </div>
            </div>
            <div class="flex flex-wrap gap-3">
              <span class="info-chip">Visibility · <%= @event.visibility.titleize %></span>
              <% if category.present? %>
                <span class="info-chip">Category · <%= category.name %></span>
              <% end %>
              <span class="info-chip">Guests · <%= @event.participant_count %></span>
            </div>
            <div class="flex flex-wrap gap-3">
              <%= link_to "View host profile", profile_path(host), class: "chip-link px-5 py-2 text-sm" %>
              <% if @event.owned_by?(current_user) %>
                <%= link_to "Edit event", edit_event_path(@event),
                      class: "chip-link--primary px-5 py-2 text-sm" %>
              <% end %>
            </div>
          </div>

          <div class="glass-panel space-y-6">
            <div class="flex items-center justify-between">
              <div>
                <h2 class="text-xl font-bold text-neutral-text">Conversation</h2>
                <p class="text-sm text-neutral-muted">Keep everyone aligned with real-time updates.</p>
              </div>
              <span class="soft-badge">
                <i class="fa-solid fa-comments"></i>
                Live
              </span>
            </div>
            <div class="space-y-6">
              <%= turbo_frame_tag "event_#{@event.id}_comments" do %>
                <%= render partial: "comments/comment", collection: @event.comments %>
              <% end %>

              <%= turbo_frame_tag "event_comment_form" do %>
                <%= render "comments/form", event: @event, comment: @comment %>
              <% end %>
            </div>
          </div>

          <%= render "shared/calendar" %>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= link_to "← Back to events", events_path,
              class: "chip-link px-6 py-3 text-xs uppercase tracking-[0.35em]" %>
        <% unless @event.owned_by?(current_user) %>
          <%= link_to "Message host", profile_path(host),
                class: "chip-link px-6 py-3 text-xs uppercase tracking-[0.35em]" %>
        <% end %>
      </div>
    </div>
  </section>
</div>
