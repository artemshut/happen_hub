<div id="invitation_status" class="bg-neutral-surface shadow-xl rounded-2xl p-6 border border-neutral-border animate-fadeIn">
  <h2 class="text-2xl font-bold mb-6 text-gray-900">Participants</h2>

  <% if event.event_participations.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

      <% { 
        accepted: "Going", 
        maybe: "Maybe", 
        declined: "Not Going", 
        pending: "Pending" 
      }.each do |status, label| %>
        <div>
          <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3"><%= label %></h3>
          <ul class="space-y-2">
            <% event.event_participations.public_send(status).each do |participant| %>
              <li class="flex items-center justify-between px-4 py-3 bg-gray-50 rounded-md border border-gray-200 shadow-sm">
                <div class="text-gray-800 text-sm font-medium">
                  <%= participant.user.full_name %>
                  <% if participant.user == event.user %>
                    <span class="ml-1 text-xs text-accent-red">(Owner)</span>
                  <% end %>
                </div>
                <div class="text-xs text-gray-400 tracking-tight">
                  <%= label %>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

    </div>
  <% else %>
    <p class="text-gray-500 text-center text-lg">No participants yet.</p>
  <% end %>

  <!-- RSVP Action Buttons -->
  <div class="mt-10 flex flex-wrap justify-center gap-4">
    <%= button_to "✔ Going", update_rsvp_event_path(event, status: "accepted"),
      method: :patch,
      class: "bg-accent-red text-white px-5 py-2 rounded-md text-sm font-medium hover:bg-red-600 transition" %>

    <%= button_to "🤔 Maybe", update_rsvp_event_path(event, status: "maybe"),
      method: :patch,
      class: "border border-gray-300 text-gray-700 px-5 py-2 rounded-md text-sm font-medium hover:bg-gray-100 transition" %>

    <%= button_to "✖ Not Going", update_rsvp_event_path(event, status: "declined"),
      method: :patch,
      class: "border border-gray-200 text-gray-400 px-5 py-2 rounded-md text-sm font-medium hover:text-gray-600 transition" %>
  </div>
</div>
