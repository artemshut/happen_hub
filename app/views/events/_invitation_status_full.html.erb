<div id="invitation_status" class="glass-panel space-y-8 animate-fadeIn">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h2 class="text-2xl font-bold text-neutral-text">Guest pulse</h2>
      <p class="text-sm text-neutral-muted">
        Track who’s in, who’s on the fence, and keep the momentum flowing.
      </p>
    </div>
    <span class="soft-badge">
      <i class="fa-solid fa-users"></i>
      RSVP
    </span>
  </div>

  <% viewer = if defined?(current_user) && viewer.nil?
                current_user
              else
                viewer
              end %>
  <% participants_by_status ||= event.participants_grouped_for(viewer) %>
  <% participant_count ||= event.participant_count %>

  <% status_labels = {
    accepted: "Going",
    maybe: "Maybe",
    declined: "Not Going",
    pending: "Pending"
  } %>

  <% statuses_to_render = if event.visibility_public?
                            Event::VISIBLE_PARTICIPATION_STATUSES.map(&:to_sym)
                          else
                            status_labels.keys
                          end %>

  <% display_participants = participants_by_status.values.flatten %>

  <% if event.visibility_public? %>
    <p class="rounded-2xl border border-brand-light/30 bg-white/70 px-4 py-3 text-sm text-neutral-muted">
      <span class="font-semibold text-brand-dark"><%= participant_count %></span> people are going.
      <% if display_participants.empty? %>
        None of your friends have RSVP’d yet—be the first.
      <% end %>
    </p>
  <% end %>

  <% if display_participants.any? %>
    <div class="grid gap-6 md:grid-cols-2">
      <% statuses_to_render.each do |status| %>
        <% participants = participants_by_status[status] || [] %>
        <% next if participants.empty? %>

        <% label = status_labels[status] || status.to_s.titleize %>
        <div class="rounded-2xl border border-brand-light/30 bg-white/90 p-5 shadow-sm">
          <h3 class="text-sm font-semibold uppercase tracking-[0.35em] text-neutral-muted mb-4"><%= label %></h3>
          <ul class="flex flex-wrap gap-3">
            <% participants.each do |participant| %>
              <li class="relative group">
                <% if participant.user.avatar.attached? %>
                  <%= image_tag participant.user.avatar.variant(resize_to_fill: [52, 52]),
                        class: "h-12 w-12 rounded-full object-cover ring-2 ring-white shadow-lg" %>
                <% else %>
                  <div class="avatar-stack__item h-12 w-12 rounded-full text-lg">
                    <%= participant.user.first_name[0].upcase %>
                  </div>
                <% end %>

                <div class="pointer-events-none absolute left-1/2 z-50 hidden w-60 -translate-x-1/2 translate-y-3 rounded-2xl border border-neutral-border bg-white p-4 text-xs text-neutral-muted shadow-xl group-hover:block">
                  <div class="flex items-center gap-3">
                    <% if participant.user.avatar.attached? %>
                      <%= image_tag participant.user.avatar.variant(resize_to_fill: [50, 50]),
                            class: "h-12 w-12 rounded-full object-cover ring-2 ring-brand-soft" %>
                    <% else %>
                      <div class="avatar-stack__item h-12 w-12 rounded-full text-lg">
                        <%= participant.user.first_name[0].upcase %>
                      </div>
                    <% end %>
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-neutral-text break-words leading-tight"><%= participant.user.full_name %></p>
                      <p class="text-xs uppercase tracking-[0.3em] text-neutral-muted break-all"><%= participant.user.username %></p>
                      <% if participant.user == event.user %>
                        <span class="text-[10px] font-semibold uppercase tracking-[0.3em] text-brand">Host</span>
                      <% end %>
                    </div>
                  </div>
                  <div class="mt-3 space-y-1 text-xs">
                    <p><span class="font-semibold text-neutral-text">Joined:</span> <%= participant.user.created_at.strftime("%B %Y") %></p>
                    <p><span class="font-semibold text-neutral-text">Events:</span> <%= participant.user.event_participations.count %></p>
                  </div>
                  <div class="mt-3">
                    <%= link_to "View profile", profile_path(participant.user),
                          class: "chip-link text-[10px]" %>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="rounded-2xl border border-dashed border-neutral-border bg-white/80 px-4 py-8 text-center text-sm text-neutral-muted">
      <% if participant_count.positive? %>
        No friends attending yet—share the invite to spark the guest list.
      <% else %>
        No participants yet. Be the first to RSVP!
      <% end %>
    </p>
  <% end %>

  <% unless event.past? %>
    <div class="flex flex-wrap justify-center gap-3 pt-4">
      <%= button_to "✔ Going", update_rsvp_event_path(event, status: "accepted"),
            method: :patch,
            class: "chip-link--primary px-6 py-3 text-xs uppercase tracking-[0.35em]" %>

      <%= button_to "🤔 Maybe", update_rsvp_event_path(event, status: "maybe"),
            method: :patch,
            class: "chip-link px-6 py-3 text-xs uppercase tracking-[0.35em]" %>

      <%= button_to "✖ Not Going", update_rsvp_event_path(event, status: "declined"),
            method: :patch,
            class: "chip-link px-6 py-3 text-xs uppercase tracking-[0.35em] text-neutral-muted" %>
    </div>
  <% end %>
</div>
