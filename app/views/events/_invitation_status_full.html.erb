<div id="invitation_status" class="bg-neutral-surface shadow-xl rounded-2xl p-6 border border-neutral-border animate-fadeIn">
  <h2 class="text-2xl font-bold mb-6 text-gray-900">Participants</h2>

  <% viewer = if defined?(current_user) && viewer.nil?
                current_user
              else
                viewer
              end %>
  <% participants_by_status ||= event.participants_grouped_for(viewer) %>
  <% participant_count ||= event.participant_count %>

  <% status_labels = {
    accepted: "Going",
    maybe: "Maybe",
    declined: "Not Going",
    pending: "Pending"
  } %>

  <% statuses_to_render = if event.visibility_public?
                            Event::VISIBLE_PARTICIPATION_STATUSES.map(&:to_sym)
                          else
                            status_labels.keys
                          end %>

  <% display_participants = participants_by_status.values.flatten %>

  <% if event.visibility_public? %>
    <p class="text-gray-600 text-sm mb-4">
      <span class="font-semibold"><%= participant_count %></span> people are going.
      <% if display_participants.empty? %>
        None of your friends have RSVP'd yet.
      <% end %>
    </p>
  <% end %>

  <% if display_participants.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <% statuses_to_render.each do |status| %>
        <% participants = participants_by_status[status] || [] %>
        <% next if participants.empty? %>
        <div>
          <% label = status_labels[status] || status.to_s.titleize %>
          <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3"><%= label %></h3>
          <ul class="flex flex-wrap gap-3">
            <% participants.each do |participant| %>
              <li class="relative group">
                <!-- Avatar or Initial -->
                <% if participant.user.avatar.attached? %>
                  <%= image_tag participant.user.avatar.variant(resize_to_fill: [48, 48]),
                        class: "w-12 h-12 rounded-full object-cover ring-2 ring-white shadow cursor-pointer" %>
                <% else %>
                  <div class="bg-brand text-white w-12 h-12 flex items-center justify-center rounded-full text-lg font-bold ring-2 ring-white shadow cursor-pointer">
                    <%= participant.user.first_name[0].upcase %>
                  </div>
                <% end %>

                <!-- Hover Card -->
                <div class="absolute left-1/2 -translate-x-1/2 mt-3 w-64 bg-white rounded-xl shadow-lg border border-gray-200 p-4 z-50 
                            hidden group-hover:block">
                  <div class="flex items-center gap-3">
                    <% if participant.user.avatar.attached? %>
                      <%= image_tag participant.user.avatar.variant(resize_to_fill: [50, 50]),
                            class: "w-12 h-12 rounded-full object-cover ring-2 ring-gray-100" %>
                    <% else %>
                      <div class="bg-brand text-white w-12 h-12 flex items-center justify-center rounded-full text-xl font-bold ring-2 ring-gray-100">
                        <%= participant.user.first_name[0].upcase %>
                      </div>
                    <% end %>
                    <div>
                      <p class="text-gray-900 font-semibold"><%= participant.user.full_name %></p>
                      <p class="text-sm text-gray-500"><%= participant.user.username %></p>
                      <% if participant.user == event.user %>
                        <span class="text-xs text-accent-pink font-semibold">(Owner)</span>
                      <% end %>
                    </div>
                  </div>
                  <div class="mt-3 text-sm text-gray-600">
                    <p><span class="font-medium">Joined:</span> <%= participant.user.created_at.strftime("%B %Y") %></p>
                    <p><span class="font-medium">Events:</span> <%= participant.user.event_participations.count %></p>
                  </div>
                  <div class="mt-4">
                    <%= link_to "View Profile", profile_path(participant.user),
                          class: "text-accent-pink text-sm font-semibold hover:underline" %>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

    </div>
  <% else %>
    <p class="text-gray-500 text-center text-lg">
      <% if participant_count.positive? %>
        No friends attending yet.
      <% else %>
        No participants yet.
      <% end %>
    </p>
  <% end %>

  <% unless event.past? %>
    <!-- RSVP Action Buttons -->
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <%= button_to "✔ Going", update_rsvp_event_path(event, status: "accepted"),
        method: :patch,
        class: "bg-accent-pink text-white px-5 py-2 rounded-md text-sm font-medium hover:bg-pink-600 transition" %>

      <%= button_to "🤔 Maybe", update_rsvp_event_path(event, status: "maybe"),
        method: :patch,
        class: "border border-gray-300 text-gray-700 px-5 py-2 rounded-md text-sm font-medium hover:bg-gray-100 transition" %>

      <%= button_to "✖ Not Going", update_rsvp_event_path(event, status: "declined"),
        method: :patch,
        class: "border border-gray-200 text-gray-400 px-5 py-2 rounded-md text-sm font-medium hover:text-gray-600 transition" %>
    </div>
  <% end %>
</div>
