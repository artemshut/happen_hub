<turbo-frame id="event_checklists_panel" class="block mt-10">
  <% allowed_manage = policy(event).update? %>
  <div class="space-y-8">
    <div class="glass-panel space-y-4">
      <div class="flex items-center gap-3">
        <div class="icon-circle text-lg">📋</div>
        <div>
          <h2 class="text-xl font-bold text-neutral-text">Event checklists</h2>
          <p class="text-sm text-neutral-muted">Break prep work into focused lists so nothing gets missed.</p>
        </div>
      </div>

      <% if allowed_manage %>
        <div class="rounded-2xl border border-dashed border-brand-light/60 bg-white/70 p-4">
          <%= form_with(model: [ event, checklist_form ], url: event_checklists_path(event), class: "space-y-3", data: { turbo_frame: "event_checklists_panel" }) do |form| %>
            <div class="grid gap-3 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
              <div>
                <%= form.label :title, "Checklist title", class: "form-label" %>
                <%= form.text_field :title, placeholder: "Hospitality, Decor...", class: "form-input" %>
                <% if checklist_form.errors[:title].present? %>
                  <p class="mt-1 text-xs text-red-600"><%= checklist_form.errors[:title].to_sentence %></p>
                <% end %>
              </div>
            </div>
            <%= form.submit "Add checklist", class: "chip-link--primary px-5 py-2 text-xs uppercase tracking-[0.35em]" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <% sortable_actions = "dragstart->sortable#dragstart dragover->sortable#dragover drop->sortable#drop dragend->sortable#dragend" %>
    <%= content_tag :div,
          class: "flex flex-col gap-10 mt-12",
          data: (allowed_manage ? { controller: "sortable", action: sortable_actions } : {}) do %>
      <% event.checklists.each do |checklist| %>
        <% next if checklist.title.blank? && checklist.items.empty? %>
        <%= render "events/checklist_panel", event:, checklist:, draggable: allowed_manage %>
      <% end %>
    <% end %>
  </div>
</turbo-frame>
