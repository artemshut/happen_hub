<% allowed_manage = policy(event).update? %>
<% return unless event.sub_events.any? || allowed_manage %>

<div class="glass-panel space-y-6 sub-event-timeline" id="sub_events_timeline_panel">
  <div class="flex flex-wrap items-center gap-3">
    <div class="icon-circle text-lg">⏱️</div>
    <div>
      <h2 class="text-xl font-bold text-neutral-text">Event timeline</h2>
      <p class="text-sm text-neutral-muted">Map out every segment and keep guests synced.</p>
    </div>
    <% if allowed_manage %>
      <div class="ml-auto">
        <%= render partial: "sub_events/new_button", locals: { event: event } %>
      </div>
    <% end %>
  </div>

  <% if allowed_manage %>
    <p class="text-xs text-neutral-muted">Drag-friendly order will mirror the sequence shown below.</p>
  <% end %>

  <div id="sub_events_timeline">
    <% if event.sub_events.any? %>
      <ol class="sub-event-timeline__list">
        <% event.sub_events.each_with_index do |segment, index| %>
          <turbo-frame id="<%= dom_id(segment) %>" src="<%= event_sub_event_path(event, segment) %>">
            <%= render "sub_events/card", event: event, sub_event: segment, sequence: index + 1 %>
          </turbo-frame>
        <% end %>
      </ol>
    <% else %>
      <p class="text-sm text-neutral-muted">No segments yet. Use “Add segment” to outline the flow.</p>
    <% end %>
  </div>
</div>
