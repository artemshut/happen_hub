<% if events.any? %>
  <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 xl:grid-cols-3 animate-fade-in">
    <% events.each do |event| %>
      <%= render 'event_card', event: event %>
    <% end %>
  </div>

  <div class="mt-8 flex justify-center">
    <%= paginate events, theme: "tailwind", params: { category_id: params[:category_id] } %>
  </div>
<% else %>
  <div class="glass-panel text-center animate-fade-in">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-soft text-brand text-2xl shadow-inner">
      <i class="fa-regular fa-calendar"></i>
    </div>
    <h3 class="mt-4 text-lg font-semibold text-neutral-text">No events match yet</h3>
    <p class="mt-2 text-sm text-neutral-muted">Try another category or create a new moment to share with your circle.</p>
    <%= link_to 'Create an event', new_event_path, data: { turbo: false },
          class: "chip-link--primary mt-5 inline-flex px-7 py-3 text-xs uppercase tracking-[0.35em]" %>
  </div>
<% end %>
