<% return unless event.files.attached? %>

<div class="form-attachment space-y-3">
  <h3 class="text-sm font-semibold text-neutral-text">Attached files</h3>
  <ul class="space-y-2">
    <% event.files.each do |file| %>
      <li class="form-attachment__item">
        <div class="flex items-center gap-3">
          <span class="form-attachment__icon"><%= attachment_icon_for(file) %></span>
          <div class="leading-tight">
            <p class="truncate max-w-[14rem] font-medium text-neutral-text" title="<%= file.filename.to_s %>">
              <%= file.filename.to_s.truncate(40) %>
            </p>
            <% if file.byte_size.present? %>
              <p class="text-xs text-neutral-muted"><%= number_to_human_size(file.byte_size) %></p>
            <% end %>
          </div>
        </div>
        <div class="flex items-center gap-3 text-xs">
          <%= link_to "Download",
                      rails_blob_path(file, disposition: "attachment"),
                      class: "chip-link px-3 py-1 text-xs" %>
          <%= link_to "Remove",
                      file_event_path(event, file_id: file.id),
                      class: "chip-link px-3 py-1 text-xs text-red-500 border-red-200 hover:text-red-600",
                      data: { turbo_method: :delete, turbo_stream: true } %>
        </div>
      </li>
    <% end %>
  </ul>
</div>
