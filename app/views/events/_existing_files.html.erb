<% return unless event.files.attached? %>

<div class="mb-6 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3">
  <h3 class="text-sm font-semibold text-gray-700 mb-2">Attached files</h3>

  <ul class="space-y-2 text-sm text-gray-700">
    <% event.files.each do |file| %>
      <li class="flex items-center justify-between rounded-md bg-white px-3 py-2 shadow-sm">
        <div class="flex items-center gap-2">
          <span class="text-lg"><%= attachment_icon_for(file) %></span>
          <div class="flex flex-col">
            <span class="truncate max-w-[14rem]" title="<%= file.filename.to_s %>">
              <%= file.filename.to_s.truncate(40) %>
            </span>
            <% if file.byte_size.present? %>
              <span class="text-xs text-gray-500">
                <%= number_to_human_size(file.byte_size) %>
              </span>
            <% end %>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <%= link_to "Download",
                      rails_blob_path(file, disposition: "attachment"),
                      class: "text-xs text-blue-600 hover:underline" %>
          <%= link_to "Remove",
                      file_event_path(event, file_id: file.id),
                      class: "text-xs text-red-600 hover:underline",
                      data: {
                        turbo_method: :delete,
                        turbo_stream: true
                      } %>
        </div>
      </li>
    <% end %>
  </ul>
</div>
