<div id="invitation_status" class="rounded-lg p-4 text-sm">
  <% if event.event_participations.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <% event.event_participations.includes(:user).each do |participant| %>
        <% user = participant.user %>
        <% status_class = case participant.rsvp_status
            when 'accepted' then 'border-green-500'
            when 'maybe' then 'border-yellow-500'
            when 'declined' then 'border-red-500'
            else 'border-gray-500'
          end
        %>

        <div class="flex items-center space-x-2 bg-gray-50 text-gray-900 font-semibold px-4 py-3 rounded-lg shadow-sm border-l-4 <%= status_class %>">
          <span class="inline-block w-full"><%= user.full_name %></span>
          <% if user == event.user %>
            <span class="text-xs text-gray-500 ml-2">(Owner)</span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 text-lg">No participants yet.</p>
  <% end %>
</div>
