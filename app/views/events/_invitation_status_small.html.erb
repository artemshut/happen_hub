<div id="invitation_status" class="rounded-lg p-4 text-sm bg-white shadow-sm border border-gray-100">
  <% if event.event_participations.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <% event.event_participations.includes(:user).each do |participant| %>
        <% user = participant.user %>
        <% status_tag = case participant.rsvp_status
            when 'accepted' then 'Going'
            when 'maybe' then 'Maybe'
            when 'declined' then 'Not Going'
            else 'Pending'
          end
        %>

        <div class="flex flex-col items-start justify-between gap-1 px-4 py-3 rounded-lg bg-gray-50 border border-gray-200 shadow-sm hover:shadow-md transition">
          <div class="text-gray-900 font-semibold leading-tight">
            <%= user.full_name %>
            <% if user == event.user %>
              <span class="text-xs text-accent-red font-medium ml-1">(Owner)</span>
            <% end %>
          </div>
          <span class="text-xs text-gray-500 tracking-wide uppercase font-semibold mt-1">
            <%= status_tag %>
          </span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 text-center text-sm">No participants yet.</p>
  <% end %>
</div>
