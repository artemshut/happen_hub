<div id="invitation_status" class="mt-3">
  <% viewer = if defined?(current_user) && viewer.nil?
                current_user
              else
                viewer
              end %>
  <% participants = event.participant_scope_for(viewer) %>
  <% participant_count ||= event.participant_count %>

  <% if participants.any? %>
    <div class="flex flex-wrap items-center gap-3">
      <% participants.each do |participant| %>
        <% user = participant.user %>
        <% status_tag = case participant.rsvp_status
            when 'accepted' then 'Going'
            when 'maybe' then 'Maybe'
            when 'declined' then 'Not Going'
            else 'Pending'
          end
        %>

        <div class="flex items-center space-x-2 bg-white border border-gray-200 rounded-full px-3 py-1 shadow-sm hover:shadow-md transition">
          <!-- Avatar -->
          <div class="w-6 h-6 rounded-full bg-gray-300 flex items-center justify-center text-xs font-semibold text-white">
            <%= user.first_name.first %>
          </div>
          <!-- Name + Status -->
          <span class="text-sm text-gray-900 font-medium"><%= user.full_name %></span>
          <% if user == event.user %>
            <span class="text-xs text-accent-red font-semibold">(Owner)</span>
          <% end %>
          <span class="text-xs text-gray-500 font-semibold ml-2"><%= status_tag %></span>
        </div>
      <% end %>
    </div>
    <% if event.visibility_public? && participant_count > participants.size %>
      <p class="text-xs text-gray-500 mt-2">
        +<%= participant_count - participants.size %> more people attending.
      </p>
    <% end %>
  <% else %>
    <p class="text-gray-500 text-center text-sm">
      <% if participant_count.positive? %>
        No friends attending yet.
      <% else %>
        No participants yet.
      <% end %>
    </p>
  <% end %>
</div>
