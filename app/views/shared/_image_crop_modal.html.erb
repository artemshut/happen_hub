<div id="<%= id %>" class="fixed inset-0 z-50 hidden bg-black bg-opacity-50 flex items-center justify-center" data-controller="image-cropper">
  <div class="bg-white rounded-lg shadow-lg p-4 w-full max-w-md">
    <div class="text-lg font-semibold mb-2">Crop Image</div>
    <img data-image-cropper-target="preview" class="max-w-full max-h-96" />

    <div class="flex justify-end mt-4">
      <button type="button" class="bg-gray-200 px-4 py-2 rounded mr-2" data-action="click->image-cropper#cancel">Cancel</button>
      <button type="button" class="bg-red-500 text-white px-4 py-2 rounded" data-action="click->image-cropper#crop">Crop & Upload</button>
    </div>
  </div>
</div>
