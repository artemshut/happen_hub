<!-- Modal content -->
<div id="avatar-cropper-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex justify-center items-center z-50" data-controller="image-cropper">
  <div class="bg-white rounded-lg p-6 w-full max-w-3xl">
    <h2 class="text-lg font-bold mb-4">Crop Your Avatar</h2>

    <!-- Cropping image -->
    <div class="flex justify-center overflow-hidden border rounded">
      <img id="avatar-cropper-image"
           data-image-cropper-target="preview"
           src=""
           class="max-w-full max-h-[70vh] object-contain"
           alt="Preview for cropping">
    </div>

    <!-- Actions -->
    <div class="mt-4 flex justify-end gap-3">
      <button type="button" data-action="click->image-cropper#cancel" class="bg-gray-100 text-gray-700 px-4 py-2 rounded">Cancel</button>
      <button type="button" data-action="click->image-cropper#crop" class="bg-red-500 text-white px-4 py-2 rounded">Crop & Upload</button>
    </div>
  </div>
</div>
