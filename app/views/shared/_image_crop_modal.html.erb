<div id="avatar-cropper-modal"
     class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex justify-center items-center z-50 animate-fadeIn"
     data-controller="image-cropper">

  <div class="bg-neutral-surface rounded-2xl shadow-2xl p-8 w-full max-w-3xl border border-neutral-border">
    <!-- Header -->
    <h2 class="text-xl font-extrabold text-neutral-text mb-6 tracking-tight">Crop Your Avatar</h2>

    <!-- Cropping image preview -->
    <div class="flex justify-center overflow-hidden border border-neutral-border rounded-xl shadow-sm bg-white">
      <img id="avatar-cropper-image"
           data-image-cropper-target="preview"
           src=""
           class="max-w-full max-h-[70vh] object-contain"
           alt="Preview for cropping">
    </div>

    <!-- Action buttons -->
    <div class="mt-6 flex justify-end gap-4">
      <button type="button"
              data-action="click->image-cropper#cancel"
              class="px-5 py-2 rounded-lg text-neutral-muted bg-neutral-bg border border-neutral-border hover:bg-neutral-border transition">
        Cancel
      </button>

      <button type="button"
              data-action="click->image-cropper#crop"
              class="px-6 py-2 rounded-lg text-white font-semibold bg-brand hover:bg-brand-dark transition">
        Crop & Upload
      </button>
    </div>
  </div>
</div>
