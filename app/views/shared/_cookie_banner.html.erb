<% unless cookies[:consent_given] %>
  <div class="fixed bottom-0 inset-x-0 bg-gray-900 text-white text-sm p-4 z-50 animate-fade-in">
    <div class="container mx-auto px-4 flex justify-between items-center">
      <span>
        This site uses cookies to enhance your experience.
        See our <%= link_to "Privacy Policy", privacy_policy_path, class: "underline" %>.
      </span>
      <%= button_to "Accept", accept_cookies_path, method: :post, class: "ml-4 bg-green-500 px-4 py-2 rounded hover:bg-green-600 text-white text-sm font-semibold" %>
    </div>
  </div>
<% end %>
