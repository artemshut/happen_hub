<div class="max-w-4xl mx-auto px-6 py-8 animate-fade-in">
  <h1 class="text-3xl font-bold text-gray-900 mb-8 text-center">Your Groups</h1>

  <% if @groups.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @groups.each do |group| %>
        <div class="relative bg-white border border-gray-200 rounded-xl shadow-sm p-6 hover:shadow-lg transition">

          <% if group.creator == current_user %>
            <!-- ⋮ Dropdown Menu -->
            <div class="absolute top-3 right-3" data-controller="dropdown">
              <button data-action="click->dropdown#toggle"
                      class="text-gray-500 hover:text-gray-700 p-1 rounded-full hover:bg-gray-100 transition">
                ⋮
              </button>
              <div data-dropdown-target="menu"
                   class="hidden absolute right-0 mt-2 w-36 bg-white border border-gray-200 rounded-md shadow-lg z-10 text-sm">
                <%= link_to 'View Group', group_path(group),
                      class: "block px-4 py-2 text-gray-700 hover:bg-gray-100" %>
                <%= link_to 'Edit', edit_group_path(group),
                      class: "block px-4 py-2 text-gray-700 hover:bg-gray-100" %>
                <%= button_to 'Delete', group_path(group),
                      method: :delete,
                      data: { turbo_confirm: "Are you sure you want to delete this group?" },
                      class: "w-full text-left px-4 py-2 text-red-600 hover:bg-red-100" %>
              </div>
            </div>
          <% end %>

          <h2 class="text-xl font-semibold text-accent-red mb-1 pr-6">
            <%= link_to group.name, group_path(group), class: "hover:underline" %>
            <% if group.creator == current_user %>
              <span class="text-sm text-gray-500 ml-1">(Admin)</span>
            <% end %>
          </h2>

          <p class="text-gray-600 text-sm mb-2">
            <strong>Members:</strong> <%= group.members.count %>
          </p>

          <p class="text-gray-600 text-sm italic">
            <%= truncate(group.description.presence || "No description provided.", length: 100) %>
          </p>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-700 text-center mt-8">
      You have no groups at the moment.
      <%= link_to 'Create a Group', new_group_path, class: "text-accent-red hover:underline font-medium" %>.
    </p>
  <% end %>
</div>
