<% content_for :main_classes, "relative flex-grow overflow-x-hidden" %>

<div class="group-shell">
  <section class="group-hero">
    <div class="group-hero__panel">
      <div class="space-y-3">
        <p class="text-xs uppercase tracking-[0.45em] text-white/70">Build your communities</p>
        <h1 class="group-hero__title">Your groups, beautifully organized</h1>
        <p class="group-hero__subtitle">
          Curate circles for every vibe, keep members in sync, and jump into planning faster than ever.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <span class="chip-link--primary px-7 py-3 text-xs uppercase tracking-[0.35em]">
          <%= pluralize(@groups.count, "active group") %>
        </span>
        <%= link_to "Create group", new_group_path,
              class: "landing-cta-secondary px-8 py-3 text-sm uppercase tracking-[0.35em]" %>
      </div>
    </div>
  </section>

  <section class="landing-section pt-0 pb-20">
    <% if @groups.any? %>
      <div class="group-grid">
        <% @groups.each do |group| %>
          <article class="group-card">
            <div class="group-card__header">
              <div>
                <h2 class="group-card__title">
                  <%= link_to group.name, group_path(group), class: "hover:text-brand" %>
                </h2>
                <p class="group-card__meta">
                  <%= pluralize(group.members.count, "member") %>
                </p>
              </div>
              <% if group.creator == current_user %>
                <span class="soft-badge">Admin</span>
              <% end %>
            </div>

            <p class="group-card__description">
              <%= truncate(group.description.presence || "No description provided yet.", length: 140) %>
            </p>

            <div class="group-card__actions">
              <%= link_to "View", group_path(group), class: "chip-link--primary px-5 py-2 text-[11px] uppercase tracking-[0.35em]" %>
              <%= link_to "Edit", edit_group_path(group), class: "chip-link px-5 py-2 text-[11px] uppercase tracking-[0.35em]" %>
              <%= button_to group_path(group),
                    method: :delete,
                    data: { turbo_confirm: "Delete this group and remove all members?" },
                    class: "chip-link px-5 py-2 text-[11px] uppercase tracking-[0.35em] text-red-500 hover:text-red-600" do %>
                Delete
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="glass-panel text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-soft text-brand text-2xl shadow-inner">
          <i class="fa-solid fa-users"></i>
        </div>
        <h2 class="mt-4 text-xl font-semibold text-neutral-text">No groups yet</h2>
        <p class="mt-2 text-sm text-neutral-muted">
          Gather your friends or teammates in a dedicated hub and start planning together.
        </p>
        <%= link_to "Create your first group",
              new_group_path,
              class: "chip-link--primary mt-5 inline-flex px-7 py-3 text-xs uppercase tracking-[0.35em]" %>
      </div>
    <% end %>
  </section>
</div>
