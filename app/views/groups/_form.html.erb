<% content_for :main_classes, "relative flex-grow overflow-x-hidden" %>

<div class="group-shell">
  <section class="group-hero">
    <div class="group-hero__panel">
      <div class="space-y-4">
        <p class="text-xs uppercase tracking-[0.45em] text-white/70"><%= @group.persisted? ? "Update group" : "Create group" %></p>
        <h1 class="group-hero__title"><%= @group.persisted? ? "Refresh your group details" : "Launch a new group" %></h1>
        <p class="group-hero__subtitle">
          Give your crew a home, outline the vibe, and handpick the members that make every plan better.
        </p>
      </div>
      <div>
        <%= link_to "Back to groups", groups_path,
              class: "chip-link px-6 py-3 text-xs uppercase tracking-[0.35em]" %>
      </div>
    </div>
  </section>

  <section class="landing-section pt-0 pb-20">
    <div class="glass-panel space-y-8">
      <%= form_with model: @group, local: true do |form| %>
        <div class="grid gap-6 md:grid-cols-2">
          <div class="space-y-4">
            <label class="form-label">Group name</label>
            <%= form.text_field :name,
                  class: "form-input text-lg font-semibold",
                  placeholder: "Film night crew" %>
          </div>
          <div class="space-y-4">
            <label class="form-label">Purpose</label>
            <%= form.text_area :description,
                  class: "form-input min-h-[140px]",
                  placeholder: "Weekly inspiration swaps, planning socials…" %>
          </div>
        </div>

        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="form-card__title">Invite friends</p>
              <p class="form-card__subtitle">Tap to add or remove members. Everyone you select joins instantly.</p>
            </div>
            <span class="info-chip"><%= pluralize(current_user.friends.count, "friend") %></span>
          </div>

          <%= hidden_field_tag "group[member_ids][]", "" %>
          <% if current_user.friends.any? %>
            <div class="grid gap-3 sm:grid-cols-2">
              <% current_user.friends.each do |friend| %>
                <% selected = @group.persisted? && @group.members.include?(friend) %>
                <div
                  class="friend-option"
                  data-controller="friend-select"
                  data-action="click->friend-select#toggle"
                  data-friend-select-target="box"
                  data-selected="<%= selected %>"
                >
                  <div>
                    <p class="font-semibold text-neutral-text"><%= friend.full_name %></p>
                    <p class="friend-option__meta">@<%= friend.tag %></p>
                  </div>
                  <div class="friend-option__checkbox">
                    <i class="fa-solid fa-check"></i>
                  </div>
                  <input
                    type="checkbox"
                    name="group[member_ids][]"
                    value="<%= friend.id %>"
                    <%= "checked" if selected %>
                    hidden
                    data-friend-select-target="input"
                  >
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="rounded-3xl border border-dashed border-brand-light/40 bg-white/70 px-5 py-6 text-sm text-neutral-muted">
              You haven’t added any friends yet. Invite connections first so you can add them to this group.
            </div>
          <% end %>
        </div>

        <div class="mt-8 flex justify-end">
          <%= form.submit(@group.persisted? ? "Save changes" : "Create group",
                class: "landing-cta-primary px-10 py-3 text-sm uppercase tracking-[0.35em]") %>
        </div>
      <% end %>
    </div>
  </section>
</div>
