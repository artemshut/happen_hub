<div class="max-w-4xl mx-auto px-6 py-8 animate-fade-in">
  <!-- Group Title -->
  <h1 class="text-3xl font-bold mb-6 text-accent-red text-center"><%= @group.name %></h1>

  <!-- Group Description -->
  <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6 mb-8">
    <h2 class="text-xl font-semibold text-gray-800 mb-2">Description</h2>
    <p class="text-gray-700">
      <%= @group.description.presence || content_tag(:em, "No description provided.") %>
    </p>
  </div>

  <!-- Group Members -->
  <% if @members.present? %>
    <h2 class="text-2xl font-semibold text-gray-900 mb-4">Group Members</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @members.each do |member| %>
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 hover:shadow-md transition">
          <p class="text-lg font-semibold text-gray-900 mb-1">
            <%= member.full_name %>
          </p>
          <p class="text-sm text-gray-500">(@<%= member.tag %>)</p>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 italic">No members in this group yet.</p>
  <% end %>

  <!-- Action Buttons -->
  <div class="flex justify-end mt-8 gap-3">
    <%= link_to 'Edit Group',
          edit_group_path(@group),
          class: "bg-accent-red text-white font-semibold px-5 py-2 rounded-lg hover:bg-red-600 transition" %>

    <%= link_to 'Back to Groups',
          groups_path,
          class: "bg-gray-100 text-gray-800 font-semibold px-5 py-2 rounded-lg hover:bg-gray-200 transition" %>
  </div>
</div>
