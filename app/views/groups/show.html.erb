<% content_for :main_classes, "relative flex-grow overflow-x-hidden" %>

<div class="group-shell">
  <section class="group-hero">
    <div class="group-hero__panel">
      <div class="space-y-4">
        <p class="text-xs uppercase tracking-[0.45em] text-white/70">Group overview</p>
        <h1 class="group-hero__title"><%= @group.name %></h1>
        <p class="group-hero__subtitle">
          <%= @group.description.presence || "This group is waiting for its story—add a short description so everyone feels the vibe." %>
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <span class="chip-link--primary px-7 py-3 text-xs uppercase tracking-[0.35em]">
          <%= pluralize(@members.count, "member") %>
        </span>
        <%= link_to "Edit group", edit_group_path(@group),
              class: "landing-cta-secondary px-8 py-3 text-sm uppercase tracking-[0.35em]" %>
        <%= link_to "Back to groups", groups_path,
              class: "chip-link px-6 py-3 text-xs uppercase tracking-[0.35em]" %>
      </div>
    </div>
  </section>

  <section class="landing-section pt-0 pb-20">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
      <div class="space-y-6">
        <div class="glass-panel space-y-4">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-neutral-text">Members</h2>
            <span class="info-chip"><%= pluralize(@members.count, "member") %></span>
          </div>

          <% if @members.present? %>
            <div class="grid gap-4 sm:grid-cols-2">
              <% @members.each do |member| %>
                <div class="member-card">
                  <p class="member-card__name"><%= member.full_name %></p>
                  <p class="member-card__tag">@<%= member.tag %></p>
                  <% if member == @group.creator %>
                    <span class="soft-badge mt-2">Group admin</span>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-neutral-muted">No members have joined this group yet.</p>
          <% end %>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="glass-panel space-y-4">
          <h3 class="text-lg font-semibold text-neutral-text">Quick actions</h3>
          <div class="flex flex-col gap-3">
            <%= link_to "Invite friends", edit_group_path(@group, anchor: "members"),
                  class: "chip-link--primary px-6 py-3 text-xs uppercase tracking-[0.35em]" %>
            <%= button_to group_path(@group),
                  method: :delete,
                  data: { turbo_confirm: "Delete this group and remove all members?" },
                  class: "chip-link px-6 py-3 text-xs uppercase tracking-[0.35em] text-red-500 hover:text-red-600" do %>
              Delete group
            <% end %>
          </div>
        </div>

        <div class="glass-panel space-y-3">
          <h3 class="text-lg font-semibold text-neutral-text">What’s next?</h3>
          <p class="text-sm text-neutral-muted">
            Create an event for this group, or capture notes in the description so everyone knows what’s happening next.
          </p>
          <%= link_to "Plan an event", new_event_path(group_id: @group.id),
                class: "chip-link px-6 py-3 text-xs uppercase tracking-[0.35em]" %>
        </div>
      </aside>
    </div>
  </section>
</div>
