<%= turbo_frame_tag dom_id(comment) do %>
  <div class="mb-6 p-4 bg-neutral-surface border border-neutral-border rounded-lg shadow-sm">
    <div class="flex justify-between items-start mb-2">
      <div>
        <p class="text-sm text-neutral-muted font-semibold">
          <%= comment.user.first_name.presence || "Anonymous" %> wrote:
        </p>
        <p class="text-neutral-text mt-1 text-base leading-snug"><%= comment.content %></p>
      </div>
      <span class="text-xs text-neutral-muted whitespace-nowrap">
        <%= time_ago_in_words(comment.created_at) %> ago
      </span>
    </div>

    <% if comment.user == current_user %>
      <div class="flex justify-end gap-4 text-sm mt-3">
        <%= link_to "Edit", edit_event_comment_path(comment.event, comment),
              data: { turbo_frame: dom_id(comment) },
              class: "text-accent-info hover:underline transition" %>

        <%= link_to "Delete", event_comment_path(comment.event, comment),
              method: :delete,
              data: { turbo_confirm: "Are you sure you want to delete this comment?" },
              class: "text-accent-error hover:underline transition" %>
      </div>
    <% end %>
  </div>
<% end %>
