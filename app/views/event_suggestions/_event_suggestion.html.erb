<%= turbo_frame_tag dom_id(suggestion) do %>
  <% card_classes = case suggestion.status
    when "approved" then "bg-green-50 border-green-200"
    when "rejected" then "bg-red-50 border-red-200"
    else "bg-white border-gray-200"
  end %>

  <div class="rounded-2xl border <%= card_classes %> shadow-sm hover:shadow-md transition relative overflow-hidden flex flex-col justify-between">
    <div class="p-4">
      <!-- Header Info -->
      <div class="mb-3 text-xs text-gray-500 flex justify-between items-center">
        <span>
          Suggested by <span class="font-semibold text-gray-800"><%= suggestion.user.full_name %></span>
        </span>
        <span class="font-mono"><%= time_ago_in_words(suggestion.created_at) %> ago</span>
      </div>

      <!-- Time Info -->
      <div class="text-sm space-y-1 text-gray-700">
        <p><strong>Start:</strong> <%= formatted_event_date(suggestion.suggested_start_time) %></p>
        <p><strong>End:</strong> <%= formatted_event_date(suggestion.suggested_end_time) %></p>
      </div>
    </div>

    <!-- Action Buttons as Footer -->
    <% if suggestion.pending? && current_user == @event.user %>
      <div class="flex border-t border-gray-200">
        <%= link_to "Accept", event_event_suggestion_path(@event, suggestion, status: "approved"),
              method: :patch,
              data: { turbo_frame: dom_id(suggestion) },
              class: "w-1/2 text-center text-sm py-2 font-medium text-green-700 bg-green-100 hover:bg-green-200 transition" %>

        <%= link_to "Reject", event_event_suggestion_path(@event, suggestion, status: "rejected"),
              method: :patch,
              data: { turbo_frame: dom_id(suggestion) },
              class: "w-1/2 text-center text-sm py-2 font-medium text-red-700 bg-red-100 hover:bg-red-200 transition border-l border-gray-200" %>
      </div>
    <% end %>

    <!-- Like Button -->
    <%= render partial: "likes/like_button", locals: { likeable: suggestion } %>
  </div>
<% end %>
