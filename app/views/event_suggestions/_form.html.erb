<turbo-frame id="new_event_suggestion">
  <%= form_with model: [@event, EventSuggestion.new], local: false, data: { turbo_frame: "suggestions" }, class: "space-y-6 p-4 bg-white shadow-md rounded-xl" do |form| %>
    <div>
      <%= form.label :suggested_start_time, 'Start Time', class: 'block text-sm font-semibold text-gray-700 mb-1' %>
      <%= form.datetime_local_field :suggested_start_time, class: 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent-red focus:border-accent-red transition' %>
    </div>

    <div>
      <%= form.label :suggested_end_time, 'End Time', class: 'block text-sm font-semibold text-gray-700 mb-1' %>
      <%= form.datetime_local_field :suggested_end_time, class: 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent-red focus:border-accent-red transition' %>
    </div>

    <div class="text-right">
      <%= form.submit 'Submit Suggestion', class: 'bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700' %>
    </div>
  <% end %>
</turbo-frame>
