<!-- app/views/public_profiles/show.html.erb -->

<div class="max-w-lg mx-auto p-6 bg-neutral-surface shadow-2xl rounded-2xl border border-neutral-border animate-fadeIn">
  <div class="text-center">
    <% if @user.avatar.attached? %>
      <%= image_tag @user.avatar.variant(resize_to_limit: [120, 120]), class: "rounded-full mx-auto w-28 h-28 object-cover ring-4 ring-brand-soft" %>
    <% else %>
      <%= image_tag "blank_avatar.jpg", class: "rounded-full mx-auto w-28 h-28 object-cover ring-4 ring-neutral-border" %>
    <% end %>

    <h1 class="text-2xl font-extrabold text-neutral-text mt-4 tracking-tight">@<%= @user.username %></h1>
    <p class="text-accent-info mt-1"><%= @user.full_name %></p>
  </div>

  <% if current_user && current_user != @user %>
    <div class="mt-4 text-center">
      <% if @is_friend %>
        <p class="text-accent-success font-medium">You're already friends</p>
      <% elsif @request_sent %>
        <p class="text-accent-coral font-medium">Friend request sent</p>
      <% else %>
        <%= button_to "Add Friend",
              send_friend_request_path(@user.username),
              method: :post,
              class: "inline-block bg-brand hover:bg-brand-dark transition-colors duration-150 text-white font-semibold px-6 py-2 rounded-full shadow-md" %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-8 text-center border-t border-neutral-border pt-6">
    <p class="text-sm text-neutral-muted mb-2">Scan to share profile</p>
    <%= image_tag RQRCode::QRCode.new(public_profile_url(@user.username)).as_png(size: 200).to_data_url,
                  alt: "QR code",
                  class: "mx-auto w-40 h-40" %>
    <p class="mt-3 text-xs text-accent-info break-words underline underline-offset-4">
      <%= public_profile_url(@user.username) %>
    </p>
  </div>
</div>
