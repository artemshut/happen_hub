<% content_for :main_classes, "relative flex-grow overflow-x-hidden" %>

<div class="profile-shell">
  <section class="profile-hero">
    <div class="profile-hero__panel">
      <div class="profile-hero__avatar">
        <% if current_user.avatar.attached? %>
          <%= image_tag current_user.avatar.variant(resize_to_fill: [168, 168]), class: "profile-avatar" %>
        <% else %>
          <%= image_tag "blank_avatar.jpg", class: "profile-avatar" %>
        <% end %>
      </div>
      <div class="profile-hero__details">
        <p class="text-xs uppercase tracking-[0.45em] text-white/70">Your profile</p>
        <h1 class="profile-hero__title">Hey <%= current_user.first_name.presence || current_user.username %>, keep shining</h1>
        <p class="profile-hero__subtitle">
          Member since <%= current_user.created_at.strftime('%B %d, %Y') %>. Share who you are, keep your details current, and make it easy for friends to connect.
        </p>
        <div class="profile-hero__actions">
          <%= link_to "Edit profile", edit_profile_path,
                class: "landing-cta-primary px-10 py-3 text-sm uppercase tracking-[0.35em]" %>
          <%= link_to "View public profile",
                public_profile_path(current_user.username),
                class: "landing-cta-secondary px-8 py-3 text-sm uppercase tracking-[0.35em]" %>
        </div>
      </div>
    </div>
  </section>

  <section class="landing-section pt-0 pb-20">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
      <div class="space-y-6">
        <% level_size = 500 %>
        <% total_xp = @user.xp %>
        <% current_level = (total_xp / level_size) + 1 %>
        <% xp_into_level = total_xp % level_size %>
        <% xp_percent = ((xp_into_level.to_f / level_size) * 100).round %>

        <div class="profile-card space-y-4 xp-card">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
              <p class="text-xs uppercase tracking-[0.45em] text-neutral-muted/80">XP Progress</p>
              <h2 class="text-2xl font-semibold text-neutral-text">Level <%= current_level %></h2>
            </div>
            <div class="text-right">
              <p class="text-sm text-neutral-muted">Total XP</p>
              <p class="text-2xl font-semibold text-brand"><%= total_xp %></p>
            </div>
          </div>
          <div class="xp-meter">
            <div class="xp-meter__bar" style="width:<%= xp_percent %>%"></div>
          </div>
          <p class="text-xs text-neutral-muted">Next level in <%= level_size - xp_into_level %> XP</p>

          <% if @badge_unlocks.present? %>
            <div class="space-y-2">
              <p class="text-xs uppercase tracking-[0.35em] text-neutral-muted/80">Unlocked badges</p>
              <div class="flex flex-wrap gap-2">
                <% @badge_unlocks.each do |badge| %>
                  <span class="badge-pill"><%= badge.to_s.humanize %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <%= render "profiles/mission_cards", missions: @user_missions %>

        <div class="profile-card">
          <h2 class="profile-card__title">Personal information</h2>
          <dl class="profile-meta-grid">
            <div>
              <dt>First name</dt>
              <dd><%= current_user.first_name.presence || "Not provided" %></dd>
            </div>
            <div>
              <dt>Last name</dt>
              <dd><%= current_user.last_name.presence || "Not provided" %></dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd><%= current_user.email %></dd>
            </div>
            <div>
              <dt>Birthday</dt>
              <dd><%= current_user.birthday ? current_user.birthday.strftime('%B %d, %Y') : "Not provided" %></dd>
            </div>
          </dl>
        </div>

        <div class="profile-card">
          <h2 class="profile-card__title">Account details</h2>
          <dl class="profile-meta-grid">
            <div>
              <dt>Tag</dt>
              <dd><%= current_user.tag.presence || "No tag available" %></dd>
            </div>
            <div>
              <dt>Username</dt>
              <dd><%= current_user.username %></dd>
            </div>
            <div class="lg:col-span-2">
              <dt>Share profile</dt>
              <dd>
                <div class="profile-share">
                  <span><%= public_profile_url(current_user.username) %></span>
                  <%= link_to "Open link",
                        public_profile_path(current_user.username),
                        class: "chip-link px-4 py-2 text-[11px] uppercase tracking-[0.35em]" %>
                </div>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="profile-card">
          <h3 class="text-lg font-semibold text-neutral-text">Need a refresh?</h3>
          <p class="text-sm text-neutral-muted">
            Update your profile details or add new friends so they can invite you faster.
          </p>
          <%= link_to "Go to friends",
                friendships_path,
                class: "chip-link px-6 py-3 text-xs uppercase tracking-[0.35em]" %>
        </div>

        <div class="profile-card space-y-4">
          <h3 class="text-lg font-semibold text-neutral-text">Danger zone</h3>
          <p class="text-sm text-neutral-muted">
            Deleting your account removes all your data, including events and groups you created.
          </p>
          <%= button_to "Delete my account",
                user_registration_path,
                method: :delete,
                data: { confirm: "Are you sure? This action cannot be undone." },
                class: "chip-link px-6 py-3 text-xs uppercase tracking-[0.35em] text-red-500 hover:text-red-600" %>
        </div>
      </aside>
    </div>
  </section>
</div>
