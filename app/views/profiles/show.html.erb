<div class="min-h-[80vh] bg-neutral-bg flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl w-full bg-neutral-surface rounded-2xl shadow-2xl p-8 text-center">
    <!-- Avatar -->
    <div class="flex justify-center mb-6">
      <% if current_user.avatar.attached? %>
        <%= image_tag current_user.avatar.variant(resize_to_fill: [160, 160]), class: "rounded-full border-4 border-white shadow-lg" %>
      <% else %>
        <%= image_tag "blank_avatar.jpg", class: "rounded-full w-40 h-40 object-cover border-4 border-white shadow-lg" %>
      <% end %>
    </div>

    <!-- Header -->
    <h1 class="text-3xl font-extrabold text-neutral-text mb-2">Your Profile</h1>
    <p class="text-neutral-muted mb-6">Member since <%= current_user.created_at.strftime('%B %d, %Y') %></p>

    <div class="mb-8">
      <%= link_to "Edit Profile", edit_profile_path, class: "bg-brand text-white px-6 py-2 rounded-lg shadow hover:bg-brand-dark transition" %>
    </div>

    <!-- Profile Details -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-left">
      <!-- Personal Info -->
      <div>
        <h2 class="text-lg font-semibold text-neutral-text mb-4">Personal Information</h2>
        <ul class="space-y-2 text-neutral-muted">
          <li><strong>First Name:</strong> <%= current_user.first_name || "Not provided" %></li>
          <li><strong>Last Name:</strong> <%= current_user.last_name || "Not provided" %></li>
          <li><strong>Email:</strong> <%= current_user.email %></li>
          <li><strong>Birthday:</strong> <%= current_user.birthday ? current_user.birthday.strftime('%B %d, %Y') : "Not provided" %></li>
        </ul>
      </div>

      <!-- Account Info -->
      <div>
        <h2 class="text-lg font-semibold text-neutral-text mb-4">Account Details</h2>
        <ul class="space-y-2 text-neutral-muted">
          <li><strong>Tag:</strong> <%= current_user.tag || "No tag available" %></li>
          <li><strong>Username:</strong> <%= current_user.username %></li>
        </ul>
      </div>
    </div>

    <!-- Public Link -->
    <div class="mt-8 text-sm text-neutral-muted">
      Share your profile: 
      <%= link_to current_user.username, public_profile_url(current_user.username), class: "text-accent-info hover:underline" %>
    </div>
  </div>
</div>
