<div class="min-h-screen flex items-center justify-center bg-neutral-bg px-4 py-12 sm:px-6 lg:px-8">
  <div class="w-full max-w-md bg-white shadow-2xl rounded-2xl p-8 animate-fadeIn">
    <!-- Header -->
    <div class="mb-6 text-center">
      <h2 class="text-3xl font-extrabold text-neutral-text">Confirm Your Email</h2>
      <p class="mt-2 text-sm text-neutral-muted">We’ll send confirmation instructions to your inbox.</p>
    </div>

    <!-- Errors -->
    <% if resource.errors.any? %>
      <div class="mb-4 bg-accent-error/10 text-accent-error p-4 rounded-lg border border-accent-error/30">
        <ul class="list-disc list-inside text-sm">
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Form -->
    <%= form_with model: resource, url: user_confirmation_path, local: true do |f| %>
      <div class="mb-4">
        <%= f.label :email, class: "block text-sm font-medium text-neutral-text" %>
        <%= f.email_field :email, autofocus: true, class: "mt-1 block w-full px-4 py-2 border border-neutral-border rounded-lg shadow-sm focus:ring-brand focus:border-brand sm:text-sm" %>
      </div>

      <div>
        <%= f.submit "Resend Confirmation", class: "w-full py-2 px-4 bg-brand text-white text-sm font-semibold rounded-lg hover:bg-brand-dark transition" %>
      </div>
    <% end %>

    <!-- Links -->
    <div class="mt-6 text-center text-sm text-neutral-muted space-y-1">
      <div>
        <%= link_to "Log in", new_session_path(resource_name), class: "text-accent-info hover:underline" %>
        &middot;
        <%= link_to "Sign up", new_registration_path(resource_name), class: "text-accent-info hover:underline" %>
        &middot;
        <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-accent-info hover:underline" %>
      </div>
    </div>
  </div>
</div>
