<div class="min-h-[80vh] flex items-center justify-center px-4">
  <div class="bg-white shadow-2xl rounded-2xl p-8 w-full max-w-md">
    <h1 class="text-2xl font-extrabold text-center text-neutral-text mb-6">Welcome Back</h1>

    <%= form_with url: user_session_path, scope: :user, local: true, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :email, "Email Address", class: "block text-sm font-medium text-neutral-text mb-1" %>
        <%= f.email_field :email, class: "w-full px-4 py-2 border border-neutral-border rounded-lg focus:ring-brand focus:border-brand" %>
      </div>

      <div>
        <%= f.label :password, "Password", class: "block text-sm font-medium text-neutral-text mb-1" %>
        <%= f.password_field :password, class: "w-full px-4 py-2 border border-neutral-border rounded-lg focus:ring-brand focus:border-brand" %>
      </div>

      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <%= f.check_box :remember_me, {}, true, false %>
          <label for="user_remember_me" class="ml-2 text-sm text-neutral-muted">Remember me</label>
        </div>
        <%= link_to "Forgot your password?", new_user_password_path, class: "text-sm text-brand hover:underline font-medium" %>
      </div>

      <div>
        <%= f.submit "Log In", class: "w-full bg-brand text-white font-bold py-2 px-4 rounded-lg hover:bg-brand-dark transition" %>
      </div>
    <% end %>

    <div class="mt-6 text-center">
      <p class="text-sm text-neutral-muted">
        Don’t have an account?
        <%= link_to "Sign Up", new_user_registration_path, class: "text-brand hover:underline font-semibold" %>
      </p>
    </div>

    <div class="mt-6 text-center">
      <p class="text-sm text-neutral-muted">
      <%= button_to "Sign in with Google", user_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: 'false' },
      class: "btn bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded" %>
      </p>
    </div>
  </div>
</div>
