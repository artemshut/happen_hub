<% @title = "Reset your HappenHub password" %>
<% password_reset_link = @reset_link || edit_password_url(@resource, reset_password_token: @token) %>

<div class="pill">Security alert</div>
<h2>Heads up, <%= @resource.email %>.</h2>
<p>Someone requested a password reset for your account. Follow the link below to swap credentials and keep your sets secure.</p>

<div class="panel">
  <p><strong>Reset checklist</strong></p>
  <ol>
    <li>Tap the button within the next 15 minutes.</li>
    <li>Choose a password that’s impossible to guess mid-set.</li>
    <li>Jump back into planning without missing a beat.</li>
  </ol>
</div>

<a href="<%= password_reset_link %>" class="cta">Reset access</a>

<p style="margin-top: 24px;">Didn’t request this? Ignore the message—your password stays the same until you confirm the change.</p>
