<div class="min-h-screen flex items-center justify-center bg-neutral-bg px-4 py-12 sm:px-6 lg:px-8">
  <div class="w-full max-w-xl bg-white shadow-2xl rounded-2xl p-8">
    <!-- Header -->
    <div class="mb-6 text-center">
      <h2 class="text-3xl font-extrabold text-neutral-text">Edit Your Account</h2>
      <p class="text-sm text-neutral-muted">Update your login credentials below.</p>
    </div>

    <!-- Error messages -->
    <%= render "devise/shared/error_messages", resource: resource %>

    <!-- Form -->
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
      <div>
        <%= f.label :email, "Email", class: "block text-sm font-medium text-neutral-text mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-2 border border-neutral-border rounded-lg focus:ring-brand focus:border-brand" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="text-sm text-yellow-600">Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
      <% end %>

      <div>
        <%= f.label :password, "New Password", class: "block text-sm font-medium text-neutral-text mb-1" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-4 py-2 border border-neutral-border rounded-lg focus:ring-brand focus:border-brand" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-neutral-muted mt-1">(<%= @minimum_password_length %> characters minimum)</p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium text-neutral-text mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-2 border border-neutral-border rounded-lg focus:ring-brand focus:border-brand" %>
      </div>

      <div>
        <%= f.label :current_password, "Current Password", class: "block text-sm font-medium text-neutral-text mb-1" %>
        <p class="text-xs text-neutral-muted mb-1">(required to confirm changes)</p>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full px-4 py-2 border border-neutral-border rounded-lg focus:ring-brand focus:border-brand" %>
      </div>

      <div class="flex justify-end">
        <%= f.submit "Update", class: "bg-brand text-white px-6 py-2 rounded-lg hover:bg-brand-dark font-semibold transition" %>
      </div>
    <% end %>

    <!-- Cancel Account -->
    <div class="mt-10">
      <h3 class="text-lg font-semibold text-red-600 mb-2">Cancel My Account</h3>
      <p class="text-sm text-neutral-muted mb-4">Unhappy with us? You can delete your account below.</p>
      <%= button_to "Cancel my account", registration_path(resource_name),
                    data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" },
                    method: :delete,
                    class: "bg-red-100 text-red-700 px-4 py-2 rounded hover:bg-red-200 text-sm font-medium transition" %>
    </div>

    <div class="mt-6 text-center">
      <%= link_to "Back", request.referer || root_path, class: "text-sm text-brand hover:underline" %>
    </div>
  </div>
</div>
