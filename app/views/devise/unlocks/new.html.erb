<div class="min-h-[80vh] flex items-center justify-center px-4">
  <div class="bg-white shadow-lg rounded-lg p-8 w-full max-w-xs">
    <h1 class="text-xl font-bold text-center text-gray-800 mb-6">Resend Unlock Instructions</h1>

    <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post }, class: "space-y-4") do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, "Email Address", class: "block text-gray-700 font-medium mb-2" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring focus:ring-accent-red focus:border-accent-red" %>
      </div>

      <div>
        <%= f.submit "Resend Unlock Instructions", class: "w-full bg-accent-red text-white font-bold py-2 px-4 rounded-lg hover:bg-red-600" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
