<div class="min-h-[80vh] flex items-center justify-center bg-neutral-bg px-4 sm:px-6 lg:px-8">
  <div class="bg-white shadow-2xl rounded-2xl p-8 w-full max-w-md animate-fadeIn">
    <!-- Header -->
    <h1 class="text-2xl font-extrabold text-center text-neutral-text mb-2">Forgot Your Password?</h1>
    <p class="text-sm text-neutral-muted text-center mb-6">No worries — we’ll send you a reset link if your email exists in our system.</p>

    <!-- Form -->
    <%= form_with model: resource, url: password_path(resource_name), local: true, class: "space-y-6" do |f| %>
      <div>
        <%= f.label :email, "Email Address", class: "block text-sm font-medium text-neutral-text mb-1" %>
        <%= f.email_field :email, class: "w-full px-4 py-2 border border-neutral-border rounded-lg focus:ring-brand focus:border-brand sm:text-sm" %>
      </div>

      <div>
        <%= f.submit "Send Reset Instructions", class: "w-full bg-brand text-white font-semibold py-2 px-4 rounded-lg hover:bg-brand-dark transition" %>
      </div>
    <% end %>

    <!-- Footer -->
    <div class="mt-6 text-center">
      <p class="text-sm text-neutral-muted">
        Remembered your password?
        <%= link_to "Log In", new_user_session_path, class: "text-brand hover:underline font-medium" %>
      </p>
    </div>
  </div>
</div>
