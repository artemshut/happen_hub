<div class="min-h-screen flex items-center justify-center bg-neutral-bg px-4 py-12 sm:px-6 lg:px-8">
  <div class="w-full max-w-md bg-white shadow-2xl rounded-2xl p-8 animate-fadeIn">
    <!-- Header -->
    <div class="mb-6 text-center">
      <h2 class="text-3xl font-extrabold text-neutral-text">Change Your Password</h2>
      <p class="mt-2 text-sm text-neutral-muted">Please enter your new password below.</p>
    </div>

    <!-- Form -->
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= f.hidden_field :reset_password_token %>

      <% if resource.errors.any? %>
        <div class="mb-4 bg-accent-error/10 text-accent-error p-4 rounded-lg border border-accent-error/30">
          <ul class="list-disc list-inside text-sm">
            <% resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Password Field -->
      <div class="mb-4">
        <%= f.label :password, "New Password", class: "block text-sm font-medium text-neutral-text" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-neutral-muted mb-1">(<%= @minimum_password_length %> characters minimum)</p>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
              class: "mt-1 block w-full px-4 py-2 border border-neutral-border rounded-lg shadow-sm focus:ring-brand focus:border-brand sm:text-sm" %>
      </div>

      <!-- Password Confirmation -->
      <div class="mb-6">
        <%= f.label :password_confirmation, "Confirm New Password", class: "block text-sm font-medium text-neutral-text" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "mt-1 block w-full px-4 py-2 border border-neutral-border rounded-lg shadow-sm focus:ring-brand focus:border-brand sm:text-sm" %>
      </div>

      <!-- Submit -->
      <div>
        <%= f.submit "Change My Password", class: "w-full py-2 px-4 bg-brand text-white text-sm font-semibold rounded-lg hover:bg-brand-dark transition" %>
      </div>
    <% end %>

    <!-- Links -->
    <div class="mt-6 text-center text-sm text-neutral-muted">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
