<% frame_id = local_assigns.fetch(:frame_id, sub_event.persisted? ? dom_id(sub_event) : "new_sub_event") %>
<% wrap_in_item = local_assigns.fetch(:wrap_in_item, true) %>
<% cancel_path = local_assigns[:cancel_path] %>

<%= turbo_frame_tag frame_id do %>
  <% if wrap_in_item %>
    <li class="sub-event-timeline__item sub-event-timeline__item--editing">
  <% end %>
  <div class="sub-event-card sub-event-card--editing">
    <h3 class="text-lg font-semibold text-neutral-text mb-3"><%= sub_event.persisted? ? "Edit segment" : "Add segment" %></h3>
    <%= form_with(model: [event, sub_event]) do |f| %>
      <div class="grid gap-4 md:grid-cols-2">
        <div class="form-field">
          <%= f.label :title, "Title", class: "form-label" %>
          <%= f.text_field :title, class: "form-input", required: true %>
        </div>
        <div class="form-field" data-controller="location-autocomplete">
          <%= f.label :location, "Location", class: "form-label" %>
          <%= f.text_field :location, class: "form-input", data: { location_autocomplete_target: "input" } %>
        </div>
        <div class="form-field">
          <%= f.label :start_time, "Starts at", class: "form-label" %>
          <%= f.datetime_field :start_time, class: "form-input" %>
        </div>
        <div class="form-field">
          <%= f.label :end_time, "Ends at", class: "form-label" %>
          <%= f.datetime_field :end_time, class: "form-input" %>
        </div>
        <div class="form-field md:col-span-2">
          <%= f.label :notes, "Notes", class: "form-label" %>
          <%= f.text_area :notes, rows: 2, class: "form-input" %>
        </div>
      </div>
      <div class="mt-4 flex flex-wrap gap-3">
        <%= f.submit sub_event.persisted? ? "Update" : "Add", class: "chip-link--primary px-6 py-2 text-xs uppercase tracking-[0.35em]" %>
        <% if sub_event.persisted? %>
          <%= link_to "Cancel", event_sub_event_path(event, sub_event), class: "chip-link px-4 py-2 text-xs uppercase tracking-[0.35em]", data: { turbo_frame: frame_id } %>
        <% else %>
          <%= link_to "Cancel", cancel_path || new_button_event_sub_events_path(event), class: "chip-link px-4 py-2 text-xs uppercase tracking-[0.35em]", data: { turbo_frame: frame_id } %>
        <% end %>
      </div>
    <% end %>
  </div>
  <% if wrap_in_item %>
    </li>
  <% end %>
<% end %>
