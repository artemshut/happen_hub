<% content_for :main_classes, "relative flex-grow overflow-x-hidden" %>

<div class="share-shell" data-controller="share"
     data-share-url-value="<%= "#{request.base_url}#{share_event_path(@event.share_token)}" %>"
     data-share-track-url-value="<%= share_event_track_path(@event.share_token) %>"
     data-share-title-value="Join <%= @event.title %>"
     data-share-text-value="Check out this event on HappenHub">
  <section class="share-hero">
    <div class="share-hero__panel">
      <div class="profile-hero__avatar">
        <% if @event.cover_image.attached? %>
          <%= image_tag @event.cover_image.variant(resize_to_fill: [220, 220]),
                class: "profile-avatar" %>
        <% else %>
          <%= image_tag "default_event.jpg", class: "profile-avatar" %>
        <% end %>
      </div>
      <div class="share-hero__details">
        <div class="share-hero__meta">
          <span><i class="fa-regular fa-calendar"></i> <%= formatted_event_date(@event.start_time) %></span>
          <span><i class="fa-solid fa-location-dot"></i> <%= @event.location.present? ? strip_tags(@event.location.to_s) : "Location TBA" %></span>
        </div>
        <h1 class="share-hero__title"><%= @event.title %></h1>
        <p class="share-hero__subtitle">
          Hosted by <strong><%= @event.user.full_name %></strong>. Tap below to jump into the full experience.
        </p>
        <div class="share-hero__actions">
          <% if user_signed_in? %>
            <%= link_to "Open in HappenHub",
                  event_path(@event),
                  class: "landing-cta-primary px-10 py-3 text-sm uppercase tracking-[0.35em]" %>
          <% else %>
            <%= link_to "Open in HappenHub",
                  new_user_session_path(return_to: event_path(@event)),
                  class: "landing-cta-primary px-10 py-3 text-sm uppercase tracking-[0.35em]" %>
          <% end %>
          <button type="button"
                  class="landing-cta-secondary px-8 py-3 text-sm uppercase tracking-[0.35em]"
                  data-action="share#copy">
            Copy invite link
          </button>
        </div>
        <p class="text-xs text-white/75" data-share-target="feedback"></p>
      </div>
    </div>
  </section>

  <section class="landing-section pt-0 pb-20">
    <div class="share-card space-y-6">
      <div class="grid gap-6 md:grid-cols-[1.2fr_0.8fr]">
        <div class="space-y-4">
          <h2 class="text-lg font-semibold text-neutral-text">About this event</h2>
          <div class="prose prose-neutral max-w-none text-neutral-muted">
            <%= @event.description.present? ? @event.description : content_tag(:p, "The host hasn't added a description yet, but you can still join the fun!") %>
          </div>
        </div>
        <div class="space-y-4">
          <div class="share-card__url">
            <span class="truncate"><%= "#{request.base_url}#{share_event_path(@event.share_token)}" %></span>
            <button type="button"
                    class="chip-link px-4 py-2 text-[11px] uppercase tracking-[0.35em]"
                    data-action="share#copy">
              Copy
            </button>
          </div>
          <ul class="space-y-2 text-sm text-neutral-muted">
            <li><strong>Visibility:</strong> <%= @event.visibility.titleize %></li>
            <li><strong>Guests attending:</strong> <%= @event.participant_count %></li>
          </ul>
        </div>
      </div>
      <p class="text-xs text-neutral-muted text-center">
        HappenHub keeps everything organized so you can focus on making memories. Create your free account to RSVP and see more details.
      </p>
    </div>
  </section>
</div>
